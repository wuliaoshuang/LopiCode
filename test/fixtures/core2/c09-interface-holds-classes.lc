; c09 一个接口类型的变量先后装不同的类；同一个列表、字典里放实现同一个接口的不同的类；按接口调，各做各的。
(接口 形状 (面积 () 小数) (名 () 文字))
(类 方 (实现 形状) (字段 边 小数 0.0) (创建 ((边 小数)) (改字段 (这) 边 边))
  (方法 面积 () -> 小数 (返回 (* (. (这) 边) (. (这) 边))))
  (方法 名 () -> 文字 (返回 "方")))
(类 长方 (实现 形状) (字段 宽 小数 0.0) (字段 高 小数 0.0)
  (创建 ((宽 小数) (高 小数)) (改字段 (这) 宽 宽) (改字段 (这) 高 高))
  (方法 面积 () -> 小数 (返回 (* (. (这) 宽) (. (这) 高))))
  (方法 名 () -> 文字 (返回 "长方")))
(类 圆 (实现 形状) (字段 半径 小数 0.0) (创建 ((半径 小数)) (改字段 (这) 半径 半径))
  (方法 面积 () -> 小数 (返回 (* 3.0 (* (. (这) 半径) (. (这) 半径)))))
  (方法 名 () -> 文字 (返回 "圆")))
(变量 当前 形状 (新 方 1.0))
(函数 说 ((s 形状)) -> 文字 (返回 (连 (发 s 名) "=" (发 s 面积))))
(函数 最大的 ((们 (列表 形状))) -> (可空 形状)
  (设 大 (标 (可空 形状) 空))
  (每个 s 们
    (如果 (是空 大) (那么 (改 大 s))
      (否则 (如果 (> (发 s 面积) (发 (必有 大) 面积)) (那么 (改 大 s))))))
  (返回 大))
(主
  (设 s (标 形状 (新 方 2.0)))
  (打印 (调 说 s))
  (改 s (新 圆 1.0))
  (打印 (调 说 s))
  (改 s (新 长方 2.0 3.5))
  (打印 (调 说 s))
  (打印 (调 说 当前))
  (改 当前 s)
  (打印 (调 说 当前))
  (设 们 (标 (列表 形状) (列 (新 方 3.0) (新 圆 2.0) (新 长方 1.0 2.0))))
  (加项 们 (新 圆 0.5))
  (设 总 0.0)
  (每个 x 们 (改 总 (+ 总 (发 x 面积))) (打印 (调 说 x)))
  (打印 (连 "总面积 " 总))
  (打印 (连 "最大的是 " (调 说 (必有 (调 最大的 们)))))
  (打印 (是空 (调 最大的 (标 (列表 形状) (列)))))
  (设 表 (标 (字典 形状) (典 ("a" (新 方 1.5)) ("b" (新 圆 1.0)))))
  (存 表 "c" (新 长方 4.0 0.5))
  (每对 k v 表 (打印 (连 k "：" (调 说 v))))
  (设 名们 (调 映射 们 (λ ((x 形状)) (发 x 名))))
  (打印 (拼 名们 ",")))
