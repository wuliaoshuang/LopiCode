; e05 套着的“试着做”：里层没对上种类的穿到外层；“出错时”里面再出错；“最后”里再套一层；三层。
(类 甲错 (继承 错误) (创建 ((话 文字)) (父创建 话)))
(类 乙错 (继承 错误) (创建 ((话 文字)) (父创建 话)))
(函数 抛 ((哪个 整数))
  (如果 (== 哪个 1) (那么 (抛出 (新 甲错 "甲"))))
  (如果 (== 哪个 2) (那么 (抛出 (新 乙错 "乙"))))
  (如果 (== 哪个 3) (那么 (抛出 "丙"))))
(主
  (设 n 0)
  (当 (< n 4)
    (试 (做 (试 (做 (试 (做 (调 抛 n) (打印 (连 n " 没事")))
                        (出错时 甲错 e (打印 (连 n " 最里层接到 " (. e 消息))))
                        (最后 (打印 (连 n " 最里层收尾")))))
                (出错时 乙错 e (打印 (连 n " 中间接到 " (. e 消息))) (调 抛 3))
                (最后 (试 (做 (打印 (连 n " 中间收尾")) (如果 (== n 1) (那么 (调 抛 2))))
                          (出错时 _ e (打印 (连 n " 收尾里又出错 " (. e 种类))))))))
        (出错时 _ e (打印 (连 n " 最外层接到 " (. e 消息) " " (. e 种类)))))
    (改 n (+ n 1))))
