; c12 把这一段的东西合起来，搭一个“小框架”的缩小版：回应（类本身的方法当工厂、默认值）、上下文（内部字段）、中间件（接口）、
; 路由（父类方法里调子类重写的）、自己定义的错误在处理函数里抛、在框架里按种类接。
(宿主 sys.print ((话 文字) (通道 文字)) -> 空)
(类 HTTP错误 可继承 (继承 错误)
  (字段 状态 整数 500)
  (字段 详情 (可空 文字))
  (创建 ((状态 整数) (话 文字) (详情 (可空 文字) 空)) (父创建 话) (改字段 (这) 状态 状态) (改字段 (这) 详情 详情)))
(类 没登录 (继承 HTTP错误) (创建 ((话 文字 "请先登录")) (父创建 401 话)))
(类 回应
  (字段 状态 整数 200)
  (字段 内容 文字 "")
  (字段 头 (字典 文字) (典))
  (创建 ((状态 整数) (内容 文字)) (改字段 (这) 状态 状态) (改字段 (这) 内容 内容))
  (类方法 文字的 ((话 文字) (状态 整数 200)) -> 回应
    (设 r (新 回应 状态 话))
    (存 (. r 头) "content-type" "text/plain")
    (返回 r))
  (类方法 JSON的 ((值 任意) (状态 整数 200)) -> 回应
    (设 r (新 回应 状态 (转JSON 值)))
    (存 (. r 头) "content-type" "application/json")
    (返回 r))
  (类方法 空的 () -> 回应 (返回 (新 回应 204 "")))
  (方法 一行 () -> 文字 (返回 (连 (. (这) 状态) " " (或空 (取 (. (这) 头) "content-type") "-") " " (. (这) 内容)))))
(类 上下文
  (内部字段 请求 (字典 文字) (典))
  (内部字段 读过了 是否 否)
  (字段 用户 (可空 文字))
  (创建 ((请求 (字典 文字))) (改字段 (这) 请求 请求))
  (方法 方式 () -> 文字 (返回 (或空 (取 (. (这) 请求) "method") "GET")))
  (方法 路径 () -> 文字 (返回 (网址解码 (或空 (取 (. (这) 请求) "path") "/"))))
  (方法 内容 () -> 文字
    (如果 (. (这) 读过了) (那么 (抛出 (新 HTTP错误 500 "内容只能读一次"))))
    (改字段 (这) 读过了 是)
    (返回 (或空 (取 (. (这) 请求) "body") ""))))
(接口 中间件 (经过 ((c 上下文) (下一步 (函数 () 回应))) 回应))
(类 记日志 (实现 中间件)
  (类字段 条 整数 0)
  (方法 经过 ((c 上下文) (下一步 (函数 () 回应))) -> 回应
    (改字段 记日志 条 (+ (. 记日志 条) 1))
    (设 r (调 下一步))
    (做 (宿 sys.print (连 "#" (. 记日志 条) " " (发 c 方式) " " (发 c 路径) " → " (. r 状态)) "out"))
    (返回 r)))
(类 要登录 (实现 中间件)
  (方法 经过 ((c 上下文) (下一步 (函数 () 回应))) -> 回应
    (如果 (且 (开头是 (发 c 路径) "/我的") (是空 (. c 用户))) (那么 (抛出 (新 没登录))))
    (返回 (调 下一步))))
(类 接住错 (实现 中间件)
  (方法 经过 ((c 上下文) (下一步 (函数 () 回应))) -> 回应
    (试 (做 (返回 (调 下一步)))
        (出错时 HTTP错误 e (返回 (发 回应 JSON的 (标 任意 (典 ("错" (. e 消息)) ("种类" (. e 种类)) ("详情" (. e 详情)))) (. e 状态))))
        (出错时 错误 e (返回 (发 回应 文字的 (连 "服务器出错：" (. e 消息)) 500))))))
(类 应用 可继承
  (字段 层 (列表 中间件) (列))
  (方法 用 ((m 中间件)) -> 应用 (加项 (. (这) 层) m) (返回 (这)))
  (方法 处理 ((c 上下文)) -> 回应 (返回 (发 回应 文字的 "没有这一页" 404)))
  (方法 走 ((c 上下文) (第几 整数)) -> 回应
    (如果 (>= 第几 (长 (. (这) 层))) (那么 (返回 (发 (这) 处理 c))))
    (返回 (发 (必有 (取 (. (这) 层) 第几)) 经过 c (λ () (发 (这) 走 c (+ 第几 1))))))
  (方法 收到 ((请求 (字典 文字)) (用户 (可空 文字) 空)) -> 文字
    (设 c (新 上下文 请求))
    (改字段 c 用户 用户)
    (返回 (发 (发 (这) 走 c 0) 一行))))
(类 我的应用 (继承 应用)
  (方法 处理 ((c 上下文)) -> 回应
    (设 路 (发 c 路径))
    (如果 (== 路 "/") (那么 (返回 (发 回应 文字的 "首页"))))
    (如果 (== 路 "/我的/名字") (那么 (返回 (发 回应 JSON的 (标 任意 (典 ("名" (. c 用户))))))))
    (如果 (== 路 "/回声") (那么 (返回 (发 回应 文字的 (连 (发 c 内容) (发 c 内容)) 201))))
    (如果 (== 路 "/除") (那么 (返回 (发 回应 文字的 (文 (整除 1 (长 (发 c 内容))))))))
    (如果 (== 路 "/你 好") (那么 (返回 (发 回应 空的))))
    (如果 (== 路 "/要数字") (那么 (如果 (非 (是数字 (发 c 内容))) (那么 (抛出 (新 HTTP错误 400 "要一个数字" "body"))))
                                (返回 (发 回应 JSON的 (标 任意 (典 ("好" 是)))))))
    (返回 (父 处理 c))))
(主
  (设 app (新 我的应用))
  (发 (发 (发 app 用 (新 记日志)) 用 (新 接住错)) 用 (新 要登录))
  (打印 (发 app 收到 (典 ("path" "/"))))
  (打印 (发 app 收到 (典 ("path" "/没有"))))
  (打印 (发 app 收到 (典 ("path" "/我的/名字"))))
  (打印 (发 app 收到 (典 ("path" "/我的/名字")) "霜霜"))
  (打印 (发 app 收到 (典 ("path" "/回声") ("method" "POST") ("body" "喂"))))
  (打印 (发 app 收到 (典 ("path" "/除") ("body" ""))))
  (打印 (发 app 收到 (典 ("path" "/%E4%BD%A0%20%E5%A5%BD"))))
  (打印 (发 app 收到 (典 ("path" "/要数字") ("body" "12a"))))
  (打印 (发 app 收到 (典 ("path" "/要数字") ("body" " 3.5 "))))
  (打印 (发 (新 应用) 收到 (典 ("path" "/")))))
