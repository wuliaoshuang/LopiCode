; e06 函数里抛、隔着几层函数在外层接；匿名函数里抛；方法里抛；接住以后把错误对象当值传、放进列表、当返回值。
(类 余额不够 (继承 错误) (字段 差 整数 0)
  (创建 ((差多少 整数)) (父创建 (连 "余额不够，还差 " 差多少)) (改字段 (这) 差 差多少)))
(类 账户 (字段 钱 整数 0)
  (创建 ((开户 整数)) (改字段 (这) 钱 开户))
  (方法 取 ((n 整数)) -> 整数
    (如果 (> n (. (这) 钱)) (那么 (抛出 (新 余额不够 (- n (. (这) 钱))))))
    (改字段 (这) 钱 (- (. (这) 钱) n))
    (返回 (. (这) 钱))))
(函数 第三层 ((a 账户) (n 整数)) -> 整数 (返回 (发 a 取 n)))
(函数 第二层 ((a 账户) (n 整数)) -> 整数 (返回 (+ 0 (调 第三层 a n))))
(函数 试一次 ((a 账户) (n 整数)) -> (可空 错误)
  (试 (做 (打印 (连 "取 " n " 还剩 " (调 第二层 a n))) (返回 空))
      (出错时 _ e (返回 e))))
(函数 说 ((e 错误)) -> 文字 (返回 (连 "[" (. e 种类) "] " (. e 消息))))
(主
  (设 a (新 账户 100))
  (设 错们 (标 (列表 错误) (列)))
  (每个 n (列 30 100 50 80)
    (设 r (调 试一次 a n))
    (如果 (非空 r) (那么 (加项 错们 (必有 r)))))
  (打印 (连 "一共 " (长 错们) " 次没取成"))
  (每个 e 错们 (打印 (调 说 e)))
  (设 f (λ块 ((x 整数)) (如果 (> x 2) (那么 (抛出 (新 数值不对 (连 x " 太大"))))) (返回 (* x 2))))
  (试 (做 (打印 (调 f 1)) (打印 (调 f 3)) (打印 "到不了"))
      (出错时 数值不对 e (打印 (调 说 e)))))
