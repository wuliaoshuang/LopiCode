; c05 单继承三层：子类多加字段、重写方法、调父类的方法、调父类的“创建时”；没写“创建时”的子类沿用父类的；字段的初值先于“创建时”。
(类 动物 可继承
  (字段 名 文字 "")
  (字段 腿 整数 4)
  (字段 记 (列表 文字) (列))
  (创建 ((名 文字)) (改字段 (这) 名 名) (加项 (. (这) 记) (连 "动物创建：" 名 " 腿=" (. (这) 腿))))
  (方法 叫 () -> 文字 (返回 "……"))
  (方法 介绍 () -> 文字 (返回 (连 (. (这) 名) "有 " (. (这) 腿) " 条腿")))
  (方法 动 ((步 整数)) -> 文字 (返回 (连 (. (这) 名) "走了 " 步 " 步"))))
(类 狗 可继承 (继承 动物)
  (字段 会的 (列表 文字) (列 "坐下"))
  (创建 ((名 文字)) (父创建 (连 "狗·" 名)) (加项 (. (这) 记) (连 "狗创建：会 " (长 (. (这) 会的)) " 样")))
  (方法 叫 () -> 文字 (返回 "汪"))
  (方法 介绍 () -> 文字 (返回 (连 (父 介绍) "，会" (拼 (. (这) 会的) "、"))))
  (方法 学 ((招 文字)) (加项 (. (这) 会的) 招)))
(类 导盲犬 (继承 狗)
  (字段 主人 文字 "")
  (创建 ((名 文字) (主人 文字)) (父创建 名) (改字段 (这) 主人 主人) (发 (这) 学 "带路"))
  (方法 介绍 () -> 文字 (返回 (连 (父 介绍) "，主人是" (. (这) 主人))))
  (方法 动 ((步 整数)) -> 文字 (返回 (连 (父 动 (* 步 2)) "（带着" (. (这) 主人) "）"))))
(类 鸟 (继承 动物)
  (创建 ((名 文字)) (父创建 名) (改字段 (这) 腿 2))
  (方法 叫 () -> 文字 (返回 (连 "啾" (父 叫)))))
(类 鱼 可继承 (继承 动物) (方法 动 ((步 整数)) -> 文字 (返回 (连 (. (这) 名) "游了 " 步 " 米"))))
(类 金鱼 (继承 鱼))
(函数 看看 ((a 动物))
  (打印 (连 (发 a 介绍) "｜" (发 a 叫) "｜" (发 a 动 3))))
(主
  (设 d (新 狗 "旺财"))
  (发 d 学 "握手")
  (调 看看 (新 动物 "某只"))
  (调 看看 d)
  (设 g (新 导盲犬 "阿福" "老张"))
  (调 看看 g)
  (调 看看 (新 鸟 "小黄"))
  (调 看看 (新 鱼 "小蓝"))
  (调 看看 (新 金鱼 "小金"))
  (打印 (拼 (. g 记) "；"))
  (设 们 (标 (列表 动物) (列 d g (新 鸟 "二黄"))))
  (每个 a 们 (打印 (发 a 叫))))
