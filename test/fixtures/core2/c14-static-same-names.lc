; c14 不同模块里同名的类，各自的“类本身的字段、方法”互不相干；被局部变量挡住的名字就是那个变量。
(模块 甲
  (类 计数 (类字段 次 整数 0) (字段 名 文字 "甲的对象") (创建 ())
    (类方法 加 ((n 整数 1)) -> 整数 (改字段 计数 次 (+ (. 计数 次) n)) (返回 (. 计数 次))))
  (公开 (函数 甲加 () -> 文字 (返回 (连 "甲 " (发 计数 加) " " (发 计数 加 10))))))
(模块 乙
  (类 计数 (类字段 次 整数 100) (字段 名 文字 "乙的对象") (创建 ())
    (类方法 加 ((n 整数 2)) -> 整数 (改字段 计数 次 (+ (. 计数 次) n)) (返回 (. 计数 次))))
  (公开 (函数 乙加 () -> 文字 (返回 (连 "乙 " (发 计数 加) " " (. 计数 次))))))
(模块 主程序 (用 甲 乙)
  (类 计数 (类字段 次 整数 -1) (字段 名 文字 "入口的对象") (创建 ())
    (类方法 加 () -> 整数 (改字段 计数 次 (- (. 计数 次) 1)) (返回 (. 计数 次))))
  (主
    (打印 (调 甲加))
    (打印 (调 乙加))
    (打印 (调 甲加))
    (打印 (连 "入口 " (发 计数 加) " " (. 计数 次)))
    (设 计数 (新 计数))
    (打印 (. 计数 名))))
