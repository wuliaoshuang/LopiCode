; c04 类本身的字段和方法（不用先有对象）：计数、造对象的“工厂”、类本身的方法互相调、内部的类字段、子类用父类的类成员。
(类 编号器 可继承
  (类字段 下一个 整数 1)
  (类字段 前缀 文字 "No.")
  (内部类字段 发过 (列表 文字) (列))
  (字段 号 文字 "")
  (创建 ((号 文字)) (改字段 (这) 号 号))
  (类方法 发号 () -> 文字
    (设 号 (连 (. 编号器 前缀) (. 编号器 下一个)))
    (改字段 编号器 下一个 (+ (. 编号器 下一个) 1))
    (加项 (. 编号器 发过) 号)
    (返回 号))
  (类方法 造 () -> 编号器 (返回 (新 编号器 (发 编号器 发号))))
  (类方法 造几个 ((n 整数 2)) -> (列表 编号器)
    (设 出 (标 (列表 编号器) (列)))
    (数 i 0 n (加项 出 (发 编号器 造)))
    (返回 出))
  (类方法 发过几个 () -> 整数 (返回 (长 (. 编号器 发过))))
  (方法 说 () -> 文字 (返回 (连 "我是 " (. (这) 号) "，下一个是 " (. 编号器 下一个)))))
(类 特别编号器 (继承 编号器)
  (类字段 特别的 整数 0)
  (创建 () (父创建 (连 "特" (发 编号器 发号))) (改字段 特别编号器 特别的 (+ (. 特别编号器 特别的) 1)))
  (类方法 清点 () -> 文字 (返回 (连 "特别的 " (. 特别编号器 特别的) " 个，一共发过 " (发 特别编号器 发过几个) " 个，最后一个 " (或空 (取 (. 编号器 发过) (- (长 (. 编号器 发过)) 1)) "?")))))
(类 数学 (类字段 圆周率 小数 3.14)
  (类方法 平方 ((x 小数)) -> 小数 (返回 (* x x)))
  (类方法 圆面积 ((r 小数 1.0)) -> 小数 (返回 (* (. 数学 圆周率) (发 数学 平方 r)))))
(主
  (打印 (发 编号器 发号))
  (设 a (发 编号器 造))
  (打印 (发 a 说))
  (改字段 编号器 前缀 "#")
  (设 们 (发 编号器 造几个))
  (每个 x 们 (打印 (. x 号)))
  (打印 (长 (发 编号器 造几个 3)))
  (设 t (新 特别编号器))
  (打印 (发 t 说))
  (打印 (发 特别编号器 清点))
  (打印 (发 编号器 发过几个))
  (打印 (. 特别编号器 下一个))
  (打印 (发 数学 圆面积))
  (打印 (发 数学 圆面积 2.0))
  (设 f (λ ((x 小数)) (发 数学 平方 x)))
  (打印 (调 f 1.5)))
