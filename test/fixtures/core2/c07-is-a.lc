; c07 “是不是某个类”：对自己的类、父类、更上面的类、接口都能问；问完可以转成那个类来用；放在“任意”里的对象也能问。
(接口 会飞 (飞 () 文字))
(接口 会游 (游 () 文字))
(类 动物 可继承 (字段 名 文字 "") (创建 ((名 文字)) (改字段 (这) 名 名)))
(类 鸟 可继承 (继承 动物) (实现 会飞) (方法 飞 () -> 文字 (返回 (连 (. (这) 名) "飞"))))
(类 鸭 (继承 鸟) (实现 会游) (方法 游 () -> 文字 (返回 (连 (. (这) 名) "游"))))
(类 鱼 (继承 动物) (实现 会游) (方法 游 () -> 文字 (返回 (连 (. (这) 名) "潜"))))
(类 石头 (字段 重 整数 3))
(函数 认 ((a 动物)) -> 文字
  (设 出 (列 (. a 名)))
  (如果 (是 动物 a) (那么 (加项 出 "动物")))
  (如果 (是 鸟 a) (那么 (加项 出 "鸟")))
  (如果 (是 鸭 a) (那么 (加项 出 "鸭")))
  (如果 (是 鱼 a) (那么 (加项 出 "鱼")))
  (如果 (是 会飞 a) (那么 (加项 出 (发 (转 会飞 a) 飞))))
  (如果 (是 会游 a) (那么 (加项 出 (发 (转 会游 a) 游))))
  (返回 (拼 出 " ")))
(函数 认任意 ((x 任意)) -> 文字
  (如果 (是 鸭 x) (那么 (返回 (连 "鸭：" (发 (转 鸭 x) 游)))))
  (如果 (是 动物 x) (那么 (返回 (连 "动物：" (. (转 动物 x) 名)))))
  (如果 (是 石头 x) (那么 (返回 (连 "石头，重 " (. (转 石头 x) 重)))))
  (如果 (是 错误 x) (那么 (返回 (连 "错误：" (. (转 错误 x) 消息)))))
  (返回 "不认识"))
(主
  (打印 (调 认 (新 动物 "某")))
  (打印 (调 认 (新 鸟 "雀")))
  (打印 (调 认 (新 鸭 "唐")))
  (打印 (调 认 (新 鱼 "鲤")))
  (打印 (调 认任意 (新 鸭 "老鸭")))
  (打印 (调 认任意 (新 鱼 "小鱼")))
  (打印 (调 认任意 (新 石头)))
  (打印 (调 认任意 (新 找不到 "丢了")))
  (打印 (调 认任意 "一句话"))
  (打印 (调 认任意 42))
  (设 f (标 会游 (新 鱼 "金")))
  (打印 (是 鱼 f) (是 鸭 f) (是 会飞 f) (是 会游 f))
  (试 (做 (打印 (发 (转 鸭 f) 飞))) (出错时 类型不对 e (打印 (连 "转不了：" (. e 种类))))))
