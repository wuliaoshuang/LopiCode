; e02 按种类分别接：细的在前、粗的在后、内置的种类、兜底的一节；小库自己报的错也分了种类。
(类 HTTP错误 可继承 (继承 错误) (字段 状态码 整数 0)
  (创建 ((码 整数) (话 文字)) (父创建 话) (改字段 (这) 状态码 码)))
(类 没权限 (继承 HTTP错误)
  (创建 ((话 文字)) (父创建 403 话)))
(函数 办事 ((n 整数)) -> 整数
  (如果 (== n 1) (那么 (抛出 (新 HTTP错误 500 "服务器坏了"))))
  (如果 (== n 2) (那么 (抛出 (新 没权限 "不让进"))))
  (如果 (== n 3) (那么 (抛出 (新 找不到 "没有这个东西"))))
  (如果 (== n 4) (那么 (抛出 "一句话")))
  (如果 (== n 5) (那么 (返回 (整除 n 0))))
  (如果 (== n 6) (那么 (返回 (项 (列 1 2) 9))))
  (如果 (== n 7) (那么 (抛出 (新 超时 "等太久了"))))
  (返回 n))
(主
  (设 i 0)
  (当 (< i 9)
    (试 (做 (打印 (连 "办成 " (调 办事 i))))
        (出错时 没权限 e (打印 (连 "没权限：" (. e 消息) " " (. e 状态码) " " (. e 种类))))
        (出错时 HTTP错误 e (打印 (连 "HTTP：" (. e 消息) " " (. e 状态码) " " (. e 种类))))
        (出错时 找不到 e (打印 (连 "找不到：" (. e 消息) " " (. e 种类))))
        (出错时 数值不对 _ (打印 "数不对"))
        (出错时 _ e (打印 (连 "别的：" (. e 消息) " " (. e 种类)))))
    (改 i (+ i 1))))
