; c13 模块里公开的类被别的模块继承：父类在“图形”模块，子类在“我的图形”和入口模块；接口、内部字段、类本身的成员都跨模块用；
; 两个模块里各有一个同名的类（没公开的那个互不相干）。
(模块 图形
  (公开 (接口 能画 (画 () 文字)))
  (公开 (类 形 可继承 (实现 能画)
    (类字段 造了 整数 0)
    (内部字段 标签 文字 "形")
    (字段 边数 整数 0)
    (创建 ((边数 整数 0)) (改字段 (这) 边数 边数) (改字段 形 造了 (+ (. 形 造了) 1)))
    (类方法 统计 () -> 文字 (返回 (连 "造了 " (. 形 造了) " 个形")))
    (方法 名 () -> 文字 (返回 (. (这) 标签)))
    (方法 面积 () -> 小数 (返回 0.0))
    (方法 画 () -> 文字 (返回 (连 (发 (这) 名) "（" (. (这) 边数) " 条边，面积 " (发 (这) 面积) "）")))))
  (类 帮手 (方法 说 () -> 文字 (返回 "图形的帮手")))
  (公开 (函数 图形帮手说 () -> 文字 (返回 (发 (新 帮手) 说))))
  (公开 (类 画错了 可继承 (继承 错误) (创建 ((话 文字 "画不出来")) (父创建 话)))))
(模块 我的图形 (用 图形)
  (公开 (类 矩形 可继承 (继承 形)
    (字段 宽 小数 0.0)
    (字段 高 小数 0.0)
    (创建 ((宽 小数) (高 小数)) (父创建 4) (改字段 (这) 宽 宽) (改字段 (这) 高 高) (改字段 (这) 标签 "矩形"))
    (方法 面积 () -> 小数
      (如果 (或 (< (. (这) 宽) 0.0) (< (. (这) 高) 0.0)) (那么 (抛出 (新 画错了 "边长不能是负的"))))
      (返回 (* (. (这) 宽) (. (这) 高))))))
  (类 帮手 (方法 说 () -> 文字 (返回 "我的图形的帮手")))
  (公开 (函数 我的帮手说 () -> 文字 (返回 (发 (新 帮手) 说)))))
(模块 店 (用 图形 我的图形)
  (类 正方形 (继承 矩形)
    (创建 ((边 小数)) (父创建 边 边) (改字段 (这) 标签 "正方形"))
    (方法 名 () -> 文字 (返回 (连 "■" (父 名)))))
  (类 点 (继承 形)
    (方法 画 () -> 文字 (返回 (连 "·" (父 画)))))
  (类 画不了的 (继承 画错了) (创建 () (父创建)))
  (函数 展示 ((x 能画)) (打印 (发 x 画)))
  (主
    (调 展示 (新 形 3))
    (调 展示 (新 矩形 2.0 3.0))
    (调 展示 (新 正方形 1.5))
    (调 展示 (新 点))
    (设 们 (标 (列表 形) (列 (新 正方形 2.0) (新 矩形 1.0 0.5) (新 点))))
    (设 总 0.0)
    (每个 s 们 (改 总 (+ 总 (发 s 面积))))
    (打印 (连 "总面积 " 总))
    (打印 (发 形 统计))
    (打印 (. 形 造了))
    (打印 (是 矩形 (取 们 0)) " " (是 正方形 (取 们 1)) " " (是 能画 (取 们 2)))
    (打印 (调 图形帮手说) "／" (调 我的帮手说))
    (试 (做 (调 展示 (新 矩形 -1.0 2.0))) (出错时 画错了 e (打印 (连 (. e 种类) "：" (. e 消息)))))
    (试 (做 (抛出 (新 画不了的))) (出错时 画错了 e (打印 (连 (. e 种类) "：" (. e 消息)))))))
