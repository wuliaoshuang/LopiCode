; e04 接住以后再抛：原样再抛（外层拿到的是同一个对象，里层改的字段外层看得到）、换一个新的错误抛、“最后”照跑。
(类 业务错误 可继承 (继承 错误) (字段 次数 整数 0)
  (创建 ((话 文字)) (父创建 话)))
(函数 里层 ()
  (试 (做 (抛出 (新 业务错误 "库存不够")))
      (出错时 业务错误 e
        (改字段 e 次数 (+ (. e 次数) 1))
        (打印 (连 "里层记一笔 " (. e 次数)))
        (抛出 e))
      (最后 (打印 "里层收尾"))))
(函数 中层 ()
  (试 (做 (调 里层))
      (出错时 错误 e
        (打印 (连 "中层路过 " (. e 种类)))
        (抛出 e))))
(函数 换一个 ()
  (试 (做 (设 xs (列 1 2)) (打印 (项 xs 5)))
      (出错时 找不到 e (抛出 (新 业务错误 (连 "换成业务错误：" (. e 消息)))))))
(主
  (试 (做 (调 中层))
      (出错时 业务错误 e (打印 (连 "外层接到 " (. e 消息) " 次数 " (. e 次数)))))
  (试 (做 (调 换一个))
      (出错时 _ e (打印 (连 (. e 种类) "：" (. e 消息)))))
  (试 (做 (试 (做 (打印 (整除 1 0)))
              (出错时 数值不对 e (打印 "小库的错原样再抛") (抛出 e))))
      (出错时 数值不对 e2 (打印 (连 "还是它：" (. e2 消息) " " (. e2 种类))))))
