; e08 小库自己报的错也是错误对象：除以 0、整数太大、越界、把空当成值用、文字变不成整数…各归各的种类；消息还是原来那句。
(函数 试 ((哪个 整数)) -> 文字
  (设 xs (列 1 2 3))
  (设 d (典 ("a" 1)))
  (设 空的 (标 (可空 整数) 空))
  (试 (做
        (如果 (== 哪个 0) (那么 (返回 (文 (整除 7 0)))))
        (如果 (== 哪个 1) (那么 (返回 (文 (余 7 0)))))
        (如果 (== 哪个 2) (那么 (返回 (文 (项 xs 3)))))
        (如果 (== 哪个 3) (那么 (改项 xs -1 0)))
        (如果 (== 哪个 4) (那么 (返回 (文 (必有 空的)))))
        (如果 (== 哪个 5) (那么 (返回 (文 (* 9007199254740991 2)))))
        (如果 (== 哪个 6) (那么 (返回 (文 (转 整数 (标 任意 "abc"))))))
        (如果 (== 哪个 7) (那么 (返回 (截 "你好" 1 9))))
        (返回 "没出错"))
      (出错时 数值不对 e (返回 (连 "数值不对｜" (. e 消息))))
      (出错时 找不到 e (返回 (连 "找不到｜" (. e 消息))))
      (出错时 类型不对 e (返回 (连 "类型不对｜" (. e 消息))))
      (出错时 _ e (返回 (连 (. e 种类) "｜" (. e 消息))))))
(主
  (设 i 0)
  (当 (< i 9)
    (打印 (连 i " " (调 试 i)))
    (改 i (+ i 1))))
