; c03 内部的字段：只有这个类自己和它的子类里面能用；外面要读、要改得走方法。
(类 保险箱 可继承
  (内部字段 密码 文字 "")
  (内部字段 里面 (列表 文字) (列))
  (内部字段 试错 整数 0)
  (字段 牌子 文字 "")
  (创建 ((牌子 文字) (密码 文字)) (改字段 (这) 牌子 牌子) (改字段 (这) 密码 密码))
  (方法 对不对 ((猜 文字)) -> 是否
    (如果 (== 猜 (. (这) 密码)) (那么 (返回 是)))
    (改字段 (这) 试错 (+ (. (这) 试错) 1))
    (返回 否))
  (方法 放 ((猜 文字) (东西 文字)) -> 是否
    (如果 (非 (发 (这) 对不对 猜)) (那么 (返回 否)))
    (加项 (. (这) 里面) 东西)
    (返回 是))
  (方法 看 ((猜 文字)) -> 文字
    (如果 (非 (发 (这) 对不对 猜)) (那么 (返回 (连 "密码不对（第 " (. (这) 试错) " 次）"))))
    (返回 (拼 (. (这) 里面) "+")))
  (方法 比密码 ((别的 保险箱)) -> 是否 (返回 (== (. (这) 密码) (. 别的 密码)))))
(类 带后门的 (继承 保险箱)
  (创建 ((密码 文字)) (父创建 "后门牌" 密码))
  (方法 后门 () -> 文字
    (改字段 (这) 试错 0)
    (返回 (连 "密码是 " (. (这) 密码) "，里面有 " (长 (. (这) 里面)) " 样")))
  (方法 用匿名函数数 () -> 整数
    (设 数 (λ ((多 整数)) (+ (长 (. (这) 里面)) 多)))
    (返回 (调 数 100))))
(主
  (设 箱 (新 保险箱 "老牌" "1234"))
  (打印 (发 箱 放 "0000" "金条"))
  (打印 (发 箱 放 "1234" "金条"))
  (打印 (发 箱 放 "1234" "合同"))
  (打印 (发 箱 看 "1111"))
  (打印 (发 箱 看 "1234"))
  (打印 (. 箱 牌子))
  (设 门 (新 带后门的 "abcd"))
  (打印 (发 门 放 "abcd" "钥匙"))
  (打印 (发 门 看 "x"))
  (打印 (发 门 后门))
  (打印 (发 门 看 "y"))
  (打印 (发 门 用匿名函数数))
  (打印 (发 箱 比密码 门))
  (打印 (发 箱 比密码 (新 保险箱 "别的" "1234"))))
