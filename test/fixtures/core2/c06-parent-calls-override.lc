; c06 父类的方法里“让自己做”，做的是子类重写的那个（Go 里靠“指回自己”）：模板方法、三层、经过匿名函数、经过接口。
(接口 有步骤 (跑 () 文字))
(类 流程 可继承 (实现 有步骤)
  (字段 记 (列表 文字) (列))
  (方法 名字 () -> 文字 (返回 "流程"))
  (方法 准备 () (加项 (. (这) 记) "默认准备"))
  (方法 干活 () (加项 (. (这) 记) "默认干活"))
  (方法 收尾 () (加项 (. (这) 记) (连 (发 (这) 名字) " 收尾")))
  (方法 跑 () -> 文字
    (发 (这) 准备)
    (发 (这) 干活)
    (发 (这) 收尾)
    (返回 (连 (发 (这) 名字) "：" (拼 (. (这) 记) " → "))))
  (方法 跑两遍 () -> 文字
    (设 做 (λ () (发 (这) 跑)))
    (调 做)
    (返回 (调 做))))
(类 做饭 可继承 (继承 流程)
  (方法 名字 () -> 文字 (返回 "做饭"))
  (方法 干活 () (加项 (. (这) 记) "炒菜")))
(类 做大餐 (继承 做饭)
  (方法 名字 () -> 文字 (返回 (连 "大餐（" (父 名字) "）")))
  (方法 准备 () (父 准备) (加项 (. (这) 记) "买菜"))
  (方法 干活 () (父 干活) (加项 (. (这) 记) "炖汤")))
(类 偷懒 (继承 流程)
  (方法 跑 () -> 文字 (返回 (连 "偷懒：只" (父 跑)))))
(函数 让它跑 ((x 有步骤)) -> 文字 (返回 (发 x 跑)))
(主
  (打印 (发 (新 流程) 跑))
  (打印 (发 (新 做饭) 跑))
  (打印 (发 (新 做大餐) 跑))
  (打印 (发 (新 偷懒) 跑))
  (打印 (发 (新 做饭) 跑两遍))
  (打印 (调 让它跑 (新 做大餐)))
  (设 当父类用 (标 流程 (新 做大餐)))
  (打印 (发 当父类用 名字))
  (打印 (发 当父类用 跑两遍)))
