; m02 跨模块：调别的模块公开的函数、用它公开的类和记录、读写它公开的变量；自己定义的错误在一个模块里抛、另一个模块里按种类接。
(模块 错误们
  (公开 (类 业务错误 可继承 (继承 错误) (字段 码 整数 0)
    (创建 ((码 整数) (话 文字)) (父创建 话) (改字段 (这) 码 码))))
  (公开 (类 没货 (继承 业务错误) (字段 货名 文字 "")
    (创建 ((货名 文字)) (父创建 1001 (连 货名 " 没货了")) (改字段 (这) 货名 货名)))))
(模块 仓库 (用 错误们)
  (变量 存货 (字典 整数) (典 ("苹果" 3) ("梨" 0)))
  (公开 (变量 出库次数 整数 0))
  (公开 (记录 出库单 (货名 文字) (数量 整数)))
  (公开 (函数 出库 ((货名 文字) (n 整数)) -> 出库单
    (如果 (非 (有键 存货 货名)) (那么 (抛出 (新 业务错误 1000 (连 "不卖 " 货名)))))
    (设 有 (或空 (取 存货 货名) 0))
    (如果 (< 有 n) (那么 (抛出 (新 没货 货名))))
    (存 存货 货名 (- 有 n))
    (改 出库次数 (+ 出库次数 1))
    (返回 (新记 出库单 (货名 货名) (数量 n))))))
(模块 店 (用 仓库 错误们)
  (函数 买 ((货名 文字) (n 整数))
    (试 (做 (设 单 (调 出库 货名 n)) (打印 (连 "买到 " (. 单 货名) "×" (. 单 数量))))
        (出错时 没货 e (打印 (连 "没货：" (. e 货名) " 码 " (. e 码))))
        (出错时 业务错误 e (打印 (连 "业务错误 " (. e 码) "：" (. e 消息))))))
  (主
    (调 买 "苹果" 2)
    (调 买 "苹果" 2)
    (调 买 "梨" 1)
    (调 买 "西瓜" 1)
    (改 出库次数 (+ 出库次数 10))
    (打印 (连 "出库次数 " 出库次数))))
