; c02 参数的默认值：函数、方法、“创建时”、调父类的“创建时”、接口里说的默认值；内置错误的“创建时”可以不给那句话。
(接口 会招呼 (招呼 ((对谁 文字 "大家") (几遍 整数 1)) 文字))
(函数 包 ((话 文字) (左 文字 "[") (右 文字 "]") (次 整数 1) (响 是否 否) (倍 小数 1.5) (附 (可空 文字) 空)) -> 文字
  (设 出 话)
  (数 i 0 次 (改 出 (连 左 出 右)))
  (返回 (连 出 " 响=" 响 " ×" 倍 " " (或空 附 "-"))))
(函数 松 ((话 = "默认的话") (n = 2))
  (打印 (连 话 "/" n)))
(类 人 可继承 (实现 会招呼)
  (字段 名 文字 "")
  (字段 岁 整数 0)
  (创建 ((名 文字 "无名") (岁 整数 18)) (改字段 (这) 名 名) (改字段 (这) 岁 岁))
  (方法 招呼 ((对谁 文字 "大家") (几遍 整数 1)) -> 文字
    (设 出 "")
    (数 i 0 几遍 (改 出 (连 出 (. (这) 名) "向" 对谁 "问好。")))
    (返回 出)))
(类 学生 (继承 人)
  (字段 班 文字 "")
  (创建 ((班 文字 "一班") (名 文字 "同学")) (父创建 名) (改字段 (这) 班 班))
  (方法 自述 ((细 是否 是)) -> 文字
    (如果 细 (那么 (返回 (连 (. (这) 班) "的" (. (这) 名) "，" (. (这) 岁) "岁"))))
    (返回 (. (这) 名))))
(类 我的错 (继承 错误)
  (字段 码 整数 0)
  (创建 ((码 整数 500) (话 文字 "出了点事")) (父创建 话) (改字段 (这) 码 码)))
(类 没话的错 (继承 错误) (创建 () (父创建)))
(主
  (打印 (调 包 "a"))
  (打印 (调 包 "a" "<"))
  (打印 (调 包 "a" "<" ">" 2 是 2.0 "尾"))
  (调 松)
  (调 松 "给了话")
  (调 松 "都给了" 9)
  (打印 (发 (新 人) 招呼))
  (打印 (发 (新 人 "老王") 招呼 "你"))
  (打印 (发 (新 人 "老王" 40) 招呼 "你" 2))
  (设 s (新 学生))
  (打印 (发 s 自述))
  (打印 (发 (新 学生 "三班" "小李") 自述 否))
  (打印 (发 s 招呼))
  (设 会 (标 会招呼 s))
  (打印 (发 会 招呼))
  (打印 (发 会 招呼 "老师" 2))
  (试 (做 (抛出 (新 错误))) (出错时 错误 e (打印 (连 "[" (. e 消息) "] " (. e 种类)))))
  (试 (做 (抛出 (新 找不到))) (出错时 找不到 e (打印 (连 "[" (. e 消息) "] " (. e 种类)))))
  (试 (做 (抛出 (新 我的错))) (出错时 我的错 e (打印 (连 (. e 码) " " (. e 消息)))))
  (试 (做 (抛出 (新 我的错 404))) (出错时 我的错 e (打印 (连 (. e 码) " " (. e 消息)))))
  (试 (做 (抛出 (新 没话的错))) (出错时 错误 e (打印 (连 "[" (. e 消息) "] " (. e 种类))))))
