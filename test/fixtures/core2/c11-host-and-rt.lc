; c11 宿主接口（写一行、现在的毫秒数、格子）和这次补的小库（是不是数字、网址解码），连着类一起用：仓库类把数据放在格子里。
(宿主 sys.print ((话 文字) (通道 文字)) -> 空)
(宿主 time.now () -> 整数)
(宿主 store.read ((名 文字)) -> 任意)
(宿主 store.update ((名 文字) (改法 (函数 (任意) 任意))) -> 任意)
(类 日志器
  (类字段 条数 整数 0)
  (类方法 记 ((话 文字) (级 文字 "信息"))
    (改字段 日志器 条数 (+ (. 日志器 条数) 1))
    (做 (宿 sys.print (连 "[" 级 "] " 话) "out"))
    (如果 (== 级 "错") (那么 (做 (宿 sys.print (连 "错误通道：" 话) "err"))))))
(类 仓库
  (内部字段 格子 文字 "")
  (创建 ((名 文字)) (改字段 (这) 格子 (连 "仓库:" 名)))
  (方法 全部 () -> (列表 任意)
    (设 现在 (宿 store.read (. (这) 格子)))
    (如果 (是空 现在) (那么 (返回 (标 (列表 任意) (列)))))
    (返回 (转 (列表 任意) 现在)))
  (方法 加 ((行 任意)) -> 整数
    (设 新的 (宿 store.update (. (这) 格子) (λ块 ((旧 任意))
      (设 行们 (标 (列表 任意) (列)))
      (如果 (非空 旧) (那么 (改 行们 (转 (列表 任意) 旧))))
      (加项 行们 行)
      (返回 行们))))
    (返回 (长 (转 (列表 任意) 新的)))))
(主
  (设 开始 (宿 time.now))
  (发 日志器 记 "开始")
  (发 日志器 记 "有点问题" "错")
  (设 库 (新 仓库 "人"))
  (打印 (长 (发 库 全部)))
  (打印 (发 库 加 "小明"))
  (打印 (发 库 加 (标 任意 (典 ("名" "小红") ("岁" 8)))))
  (设 拿到 (发 库 全部))
  (打印 (文 拿到))
  (加项 拿到 "在外面加的不算")
  (打印 (长 (发 库 全部)))
  (打印 (长 (发 (新 仓库 "人") 全部)) " " (长 (发 (新 仓库 "别的") 全部)))
  (试 (做 (做 (宿 store.update "套" (λ ((旧 任意)) (宿 store.update "套" (λ ((里 任意)) 里))))))
      (出错时 错误 e (打印 (. e 消息))))
  (打印 (文 (宿 store.update "套" (λ ((旧 任意)) (标 任意 1)))))
  (试 (做 (做 (宿 sys.print "x" "别的通道"))) (出错时 错误 e (打印 (. e 消息))))
  (打印 (是数字 "12") (是数字 "-1.5") (是数字 "1e3") (是数字 " 7 ") (是数字 ".5") (是数字 "5.") (是数字 3) (是数字 2.5))
  (打印 (是数字 "") (是数字 "abc") (是数字 "1e999") (是数字 ".") (是数字 "1 2") (是数字 "0x10") (是数字 "１２") (是数字 是) (是数字 空) (是数字 (列 1)))
  (打印 (网址解码 "a%20b%2Fc%3F") "|" (网址解码 "%E4%BD%A0%E5%A5%BD") "|" (网址解码 "a+b") "|" (网址解码 "不用解"))
  (试 (做 (打印 (网址解码 "100%"))) (出错时 错误 e (打印 (. e 消息))))
  (试 (做 (打印 (网址解码 "%E4%BD"))) (出错时 错误 e (打印 (. e 消息))))
  (设 用时 (- (宿 time.now) 开始))
  (打印 (且 (>= 用时 0) (< 用时 600000)) " " (> 开始 1700000000000))
  (打印 (连 "日志 " (. 日志器 条数) " 条")))
