; e10 同一个名字在不同的“出错时”里是不同的种类（各读各的字段）；一句话抛出来的是“错误”；错误变量重新放东西；“是不是”判断；出了“试着做”还能用。
(类 甲错 可继承 (继承 错误) (字段 甲数 整数 1) (创建 ((话 文字)) (父创建 话)))
(类 乙错 (继承 甲错) (字段 乙话 文字 "乙的") (创建 ((话 文字)) (父创建 话)))
(类 丙错 (继承 错误) (字段 丙数 小数 2.5) (创建 ((话 文字)) (父创建 话)))
(函数 抛 ((n 整数))
  (如果 (== n 0) (那么 (抛出 (新 甲错 "甲来了"))))
  (如果 (== n 1) (那么 (抛出 (新 乙错 "乙来了"))))
  (如果 (== n 2) (那么 (抛出 (新 丙错 "丙来了"))))
  (抛出 (连 "第 " n " 种，只有一句话")))
(主
  (设 n 0)
  (当 (< n 4)
    (试 (做 (调 抛 n))
        (出错时 乙错 e (打印 (连 "乙：" (. e 乙话) " " (. e 甲数) " " (. e 消息))))
        (出错时 甲错 e (打印 (连 "甲：" (. e 甲数) " " (. e 消息))))
        (出错时 丙错 e (打印 (连 "丙：" (. e 丙数) " " (. e 消息))))
        (出错时 _ e
          (打印 (连 "别的：" (. e 种类) " " (. e 消息) " 是甲错吗 " (是 甲错 e)))
          (改 e (新 丙错 "换了一个"))
          (打印 (连 "换完：" (. e 种类) " " (. e 消息)))))
    (打印 (连 "出来以后还在：" (. e 种类) " 是错误吗 " (是 错误 e) " 是甲错吗 " (是 甲错 e)))
    (改 n (+ n 1))))
