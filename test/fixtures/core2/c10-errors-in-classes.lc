; c10 类里抛出、接住自己定义的错误：错误类带自己的字段和方法、方法里“试着做…出错时…最后总要”、接住再换一种抛、没接住的从方法里传出来。
(类 余额不足 可继承 (继承 错误)
  (字段 差 整数 0)
  (创建 ((差 整数)) (父创建 (连 "还差 " 差 " 块")) (改字段 (这) 差 差))
  (方法 说明 () -> 文字 (返回 (连 (. (这) 种类) "（" (. (这) 消息) "）"))))
(类 冻结了 (继承 余额不足)
  (创建 () (父创建 0))
  (方法 说明 () -> 文字 (返回 (连 "冻结：" (父 说明)))))
(类 转账失败 (继承 错误)
  (字段 原因 文字 "")
  (创建 ((原因 文字) (话 文字 "转账没成")) (父创建 话) (改字段 (这) 原因 原因)))
(类 账户
  (字段 钱 整数 0)
  (字段 冻 是否 否)
  (字段 日志 (列表 文字) (列))
  (创建 ((钱 整数)) (改字段 (这) 钱 钱))
  (方法 扣 ((n 整数))
    (如果 (. (这) 冻) (那么 (抛出 (新 冻结了))))
    (如果 (< n 0) (那么 (抛出 (新 数值不对 "不能扣负数"))))
    (如果 (> n (. (这) 钱)) (那么 (抛出 (新 余额不足 (- n (. (这) 钱))))))
    (改字段 (这) 钱 (- (. (这) 钱) n)))
  (方法 试着扣 ((n 整数)) -> 文字
    (试 (做 (发 (这) 扣 n) (返回 (连 "扣了 " n)))
        (出错时 冻结了 e (返回 (发 e 说明)))
        (出错时 余额不足 e (返回 (连 (发 e 说明) " 差=" (. e 差))))
        (最后 (加项 (. (这) 日志) (连 "试扣 " n)))))
  (方法 转给 ((对方 账户) (n 整数))
    (试 (做 (发 (这) 扣 n) (改字段 对方 钱 (+ (. 对方 钱) n)))
        (出错时 余额不足 e (抛出 (新 转账失败 (. e 种类))))
        (出错时 数值不对 e (抛出 (新 转账失败 (. e 消息) "数不对"))))))
(主
  (设 甲 (新 账户 100))
  (设 乙 (新 账户 0))
  (打印 (发 甲 试着扣 30))
  (打印 (发 甲 试着扣 100))
  (改字段 甲 冻 是)
  (打印 (发 甲 试着扣 1))
  (改字段 甲 冻 否)
  (试 (做 (打印 (发 甲 试着扣 -5))) (出错时 数值不对 e (打印 (连 "外面接到：" (. e 消息)))))
  (打印 (拼 (. 甲 日志) "、"))
  (发 甲 转给 乙 50)
  (打印 (连 (. 甲 钱) "/" (. 乙 钱)))
  (试 (做 (发 甲 转给 乙 500)) (出错时 转账失败 e (打印 (连 (. e 消息) "：" (. e 原因) " " (. e 种类)))))
  (试 (做 (发 甲 转给 乙 -1)) (出错时 错误 e (打印 (连 (. e 消息) " " (. e 种类) " " (是 转账失败 e)))))
  (改字段 乙 冻 是)
  (发 乙 转给 甲 1)
  (打印 "到不了这"))
