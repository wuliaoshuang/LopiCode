; c08 接口：声明、一个类实现好几个接口、子类自动也算实现了、接口当参数 / 返回值 / 字段 / 列表项的类型、可空的接口。
(接口 有名字 (名字 () 文字))
(接口 能算价 (价 ((数量 整数)) 整数) (打折 ((几折 整数 9)) 整数))
(接口 能比 (比 ((别的 能算价)) 是否))
(类 商品 可继承 (实现 有名字 能算价 能比)
  (字段 叫 文字 "")
  (字段 单价 整数 0)
  (创建 ((叫 文字) (单价 整数)) (改字段 (这) 叫 叫) (改字段 (这) 单价 单价))
  (方法 名字 () -> 文字 (返回 (. (这) 叫)))
  (方法 价 ((数量 整数)) -> 整数 (返回 (* (. (这) 单价) 数量)))
  (方法 打折 ((几折 整数 9)) -> 整数 (返回 (整除 (* (. (这) 单价) 几折) 10)))
  (方法 比 ((别的 能算价)) -> 是否 (返回 (> (发 (这) 价 1) (发 别的 价 1)))))
(类 进口商品 (继承 商品)
  (方法 价 ((数量 整数)) -> 整数 (返回 (+ (父 价 数量) 5))))
(类 服务 (实现 能算价 有名字)
  (方法 名字 () -> 文字 (返回 "上门服务"))
  (方法 价 ((数量 整数)) -> 整数 (返回 (+ 30 (* 数量 20))))
  (方法 打折 ((几折 整数 9)) -> 整数 (返回 (* 几折 5))))
(类 购物车
  (字段 东西 (列表 能算价) (列))
  (字段 最贵的 (可空 能算价))
  (方法 加 ((x 能算价)) -> 购物车
    (加项 (. (这) 东西) x)
    (设 现在 (. (这) 最贵的))
    (如果 (是空 现在) (那么 (改字段 (这) 最贵的 x))
      (否则 (如果 (> (发 x 价 1) (发 (必有 现在) 价 1)) (那么 (改字段 (这) 最贵的 x)))))
    (返回 (这)))
  (方法 总价 () -> 整数
    (设 总 0)
    (每个 x (. (这) 东西) (改 总 (+ 总 (发 x 价 1))))
    (返回 总)))
(函数 叫什么 ((x 有名字)) -> 文字 (返回 (连 "〈" (发 x 名字) "〉")))
(函数 挑 ((贵 是否)) -> 能算价
  (如果 贵 (那么 (返回 (新 进口商品 "红酒" 200))))
  (返回 (新 服务)))
(主
  (设 米 (新 商品 "米" 30))
  (设 酒 (新 进口商品 "酒" 100))
  (设 修 (新 服务))
  (打印 (调 叫什么 米) (调 叫什么 酒) (调 叫什么 修))
  (打印 (发 米 价 2) " " (发 酒 价 2) " " (发 修 价 2))
  (打印 (发 米 打折) " " (发 米 打折 5) " " (发 修 打折))
  (打印 (发 米 比 酒) " " (发 酒 比 修) " " (发 酒 比 米))
  (设 车 (新 购物车))
  (打印 (是空 (. 车 最贵的)))
  (发 (发 (发 车 加 米) 加 酒) 加 修)
  (打印 (发 车 总价))
  (打印 (发 (必有 (. 车 最贵的)) 价 1))
  (打印 (发 (调 挑 是) 价 1) " " (发 (调 挑 否) 打折 8))
  (设 比的 (标 能比 米))
  (打印 (发 比的 比 (调 挑 否))))
