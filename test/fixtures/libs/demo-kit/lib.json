{
  "kind": "lopicode-lib",
  "format": 1,
  "id": "demo/kit",
  "name": "小工具",
  "version": "1.0.0",
  "summary": "示例库：四种定义积木的办法各一块",
  "rules": 2,
  "modules": [{"file": "modules/kit.lc", "name": "小工具"}],
  "blocks": ["blocks.json"],
