; 一致性样本里“只考服务这一层”的那些接口，照严格写法手写的（核心 2·A5 段第 2 步留下的样例）。
; “接口服务”那一层（路由、跨域、读请求、回应、数据集合、时间）不再在这里抄一份：直接用产品里的内置库模块
; （lib/backend/lib_service_module.dart，只有这一个来源）。测试把库的模块和这个模块连成一个程序。
(模块 样本 (用 接口服务)
  ; —— 样本接口（照 test/support/backend_conformance.dart 里同名的接口，按严格写法手写）——
  (函数 找不到待办 ((r 请求)) -> (字典 任意)
    (返回 (调 回JSON 404 (标 任意 (典 ("error" (连 "找不到 id 是 " (调 路径参数 r "id") " 的待办")))))))
  (主
    (设 表 (调 新路由表))
    (做 (调 加路由 表 "GET" "/todos" (λ ((r 请求)) (调 回JSON 200 (标 任意 (调 全部记录 "todos"))))))
    (做 (调 加路由 表 "POST" "/todos" (λ块 ((r 请求))
      (设 标题 (调 字段 (调 读内容 r) "title"))
      (如果 (是空 标题) (那么 (返回 (调 回JSON 400 (标 任意 (典 ("error" "缺少 title")))))))
      (设 待办 (调 加一条 "todos" (标 任意 (典 ("title" 标题) ("done" (标 任意 否))))))
      (返回 (调 回JSON 201 待办)))))
    (做 (调 加路由 表 "GET" "/todos/count" (λ ((r 请求)) (调 回JSON 200 (标 任意 (典 ("count" (调 有几条 "todos"))))))))
    (做 (调 加路由 表 "GET" "/todos/:id" (λ块 ((r 请求))
      (设 待办 (调 按号取 "todos" (标 任意 (调 路径参数 r "id"))))
      (如果 (是空 待办) (那么 (返回 (调 找不到待办 r))))
      (返回 (调 回JSON 200 待办)))))
    (做 (调 加路由 表 "PATCH" "/todos/:id" (λ块 ((r 请求))
      (设 号 (标 任意 (调 路径参数 r "id")))
      (如果 (是空 (调 按号取 "todos" 号)) (那么 (返回 (调 找不到待办 r))))
      (做 (调 改一条 "todos" 号 (调 读内容 r)))
      (返回 (调 回JSON 200 (调 按号取 "todos" 号))))))
    (做 (调 加路由 表 "DELETE" "/todos/:id" (λ块 ((r 请求))
      (设 号 (标 任意 (调 路径参数 r "id")))
      (如果 (是空 (调 按号取 "todos" 号)) (那么 (返回 (调 找不到待办 r))))
      (做 (调 删一条 "todos" 号))
      (返回 (调 没有内容)))))
    (做 (调 加路由 表 "GET" "/done" (λ ((r 请求)) (调 回JSON 200 (标 任意 (调 按字段找 "todos" "done" (标 任意 是)))))))
    (做 (调 加路由 表 "GET" "/by-title" (λ ((r 请求)) (调 回JSON 200 (标 任意 (调 按字段找 "todos" "title" (标 任意 (调 网址参数 r "t"))))))))
    (做 (调 加路由 表 "POST" "/notes" (λ块 ((r 请求))
      (做 (调 加一条 "notes" (调 读内容 r)))
      (返回 (调 回JSON 200 (标 任意 (调 全部记录 "notes")))))))
    (做 (调 加路由 表 "POST" "/echo" (λ块 ((r 请求))
      (设 内容 (调 读内容 r))
      (设 名字 (调 字段 内容 "name"))
      (返回 (调 回JSON 200 (标 任意 (典
        ("body" 内容) ("name" 名字) ("nameLen" (标 任意 (调 长度 名字)))
        ("q" (标 任意 (调 网址参数 r "q"))) ("missing" (标 任意 (调 网址参数 r "nope")))
        ("header" (调 请求头 r "X-Test")) ("noHeader" (调 请求头 r "X-Nope"))
        ("noBody" (标 任意 (是空 内容))))))))))
    (做 (调 加路由 表 "GET" "/status" (λ ((r 请求))
      (调 回应 (调 状态码 (标 任意 (调 网址参数 r "code"))) "application/json; charset=utf-8" (转JSON (标 任意 (典 ("ok" 是))))))))
    (做 (调 加路由 表 "GET" "/" (λ ((r 请求)) (调 回文字 200 (标 任意 "根")))))
    (做 (调 加路由 表 "PUT" "/a/:x/b/:y" (λ ((r 请求))
      (调 回JSON 200 (标 任意 (典 ("x" (调 路径参数 r "x")) ("y" (调 路径参数 r "y"))))))))
    (做 (调 加路由 表 "GET" "/say" (λ ((r 请求)) (调 回文字 200 (标 任意 (调 网址参数 r "t"))))))
    (做 (调 加路由 表 "GET" "/now" (λ ((r 请求)) (调 回文字 200 (标 任意 (调 现在))))))
    (做 (调 开服务 表 8080))))
