; “小框架”库（七个模块）＋示例服务“小书店”，从原型 docs/blocks-v5-prototypes/02-web-framework/ 搬过来、加上类型。
; 原型不带类型；这里怎么换算的（宿主名字、小库名字、加了类型以后改了写法的地方）见同目录的 README.md。

; —— 错误：带状态码的错误类。抛出以后由“错误处理”中间件变成对应的响应。——
(模块 错误们
  (公开 (类 HTTP错误 可继承 (继承 错误)
    (字段 状态码 整数 500)
    (字段 详情 任意 空)
    (创建 ((状态码 整数) (话 文字) (详情 任意 空))
      (父创建 话)
      (改字段 (这) 状态码 状态码)
      (改字段 (这) 详情 详情))
    ; 变成回给调用方的内容。子类可以改写。
    (方法 变成内容 () -> (字典 任意)
      (设 内容 (字典 任意) (典 ("error" (. (这) 消息))))
      (如果 (非 (是空 (. (这) 详情))) (那么 (存 内容 "details" (. (这) 详情))))
      (返回 内容))))
  (公开 (类 请求不对 (继承 HTTP错误)
    (创建 ((话 文字) (详情 任意 空)) (父创建 400 话 详情))))
  (公开 (类 未授权 (继承 HTTP错误)
    (创建 ((话 文字 "请先登录")) (父创建 401 话))))
  (公开 (类 没有这个 (继承 HTTP错误)
    (创建 ((话 文字 "没有这个接口")) (父创建 404 话))))
  (公开 (类 方式不对 (继承 HTTP错误)
    (字段 允许的 (列表 文字) (列))
    (创建 ((允许的 (列表 文字)))
      (父创建 405 "这个地址不支持这种请求方式")
      (改字段 (这) 允许的 允许的))))
  (公开 (类 校验没过 (继承 HTTP错误)
    (创建 ((问题们 (列表 文字))) (父创建 422 "提交的内容不对" (标 任意 问题们))))))

; —— 响应：一个可以在中间件里继续改的响应对象。——
(模块 响应
  (公开 (类 响应
    (字段 状态码 整数 200)
    (字段 头 (字典 文字) (典))
    (字段 内容 文字 "")
    (创建 ((状态码 整数) (类型 文字) (内容 文字))
      (改字段 (这) 状态码 状态码)
      (如果 (!= 类型 "") (那么 (存 (. (这) 头) "Content-Type" 类型)))
      (改字段 (这) 内容 内容))
    (类方法 JSON ((状态码 整数) (值 任意)) -> 响应
      (返回 (新 响应 状态码 "application/json; charset=utf-8" (转JSON 值))))
    (类方法 文字 ((状态码 整数) (值 任意)) -> 响应
      (返回 (新 响应 状态码 "text/plain; charset=utf-8" (文 值))))
    (类方法 空的 () -> 响应
      (返回 (新 响应 204 "" "")))
    ; 加一个响应头；返回自己，方便连着写。
    (方法 加头 ((名字 文字) (值 文字)) -> 响应
      (存 (. (这) 头) 名字 值)
      (返回 (这)))
    ; 变成宿主认的字典。
    (方法 变成字典 () -> (字典 任意)
      (返回 (典 ("status" (. (这) 状态码)) ("headers" (. (这) 头)) ("body" (. (这) 内容))))))))

; —— 上下文：一次请求从头到尾带着的东西。中间件可以往“数据”里放东西给后面的用（这就是“改请求”）。——
(模块 上下文
  ; 网址解码：写坏了的就原样留着（原型的宿主是这样的；小库的“网址解码”写坏了会出错）。
  (函数 解码 ((原文 文字)) -> 文字
    (试 (做 (返回 (网址解码 原文))) (出错时 错误 _ (返回 原文)))
    (返回 原文))
  (函数 解析网址参数 ((原文 文字)) -> (字典 文字)
    (设 表 (字典 文字) (典))
    (每个 段 (切 原文 "&")
      (如果 (== 段 "") (那么 (继续)))
      (设 等号 (位置 段 "="))
      (设 键 段)
      (设 值 "")
      (如果 (>= 等号 0) (那么
        (改 键 (截 段 0 等号))
        (改 值 (截 段 (+ 等号 1) (文长 段)))))
      (改 键 (调 解码 (换 键 "+" " ")))
      (如果 (非 (有键 表 键)) (那么 (存 表 键 (调 解码 (换 值 "+" " "))))))
    (返回 表))
  (公开 (类 上下文
    (字段 方式 文字 "")
    (字段 路径 文字 "")
    (字段 段们 (列表 文字) (列))
    (字段 路径参数们 (字典 文字) (典))
    (字段 网址参数们 (字典 文字) (典))
    (字段 数据 (字典 任意) (典))
    (内部字段 请求 (字典 任意) (典))
    (内部字段 内容读过了 是否 否)
    (内部字段 内容值 任意 空)
    (创建 ((请求 (字典 任意)))
      (改字段 (这) 请求 请求)
      (改字段 (这) 方式 (转 文字 (取 请求 "method")))
      (改字段 (这) 路径 (转 文字 (取 请求 "path")))
      (每个 段 (切 (. (这) 路径) "/")
        (如果 (!= 段 "") (那么 (加项 (. (这) 段们) (调 解码 段)))))
      (改字段 (这) 网址参数们 (调 解析网址参数 (转 文字 (取 请求 "query")))))
    (方法 路径参数 ((名字 文字)) -> (可空 文字)
      (返回 (取 (. (这) 路径参数们) 名字)))
    (方法 网址参数 ((名字 文字)) -> (可空 文字)
      (返回 (取 (. (这) 网址参数们) 名字)))
    (方法 请求头 ((名字 文字)) -> (可空 文字)
      (返回 (转 (可空 文字) (取 (转 (字典 任意) (取 (. (这) 请求) "headers")) (小写 名字)))))
    ; 请求内容按 JSON 解析（只解析一次）；没提交、不是合法 JSON → 空。
    (方法 内容 () -> 任意
      (如果 (非 (. (这) 内容读过了)) (那么
        (改字段 (这) 内容读过了 是)
        (设 原文 (取 (. (这) 请求) "body"))
        (如果 (是类 原文 "text") (那么
          (试 (做 (改字段 (这) 内容值 (读JSON (转 文字 原文))))
              (出错时 错误 _ (改字段 (这) 内容值 空)))))))
      (返回 (. (这) 内容值)))
    (方法 放 ((名字 文字) (值 任意))
      (存 (. (这) 数据) 名字 值))
    (方法 取 ((名字 文字)) -> 任意
      (返回 (取 (. (这) 数据) 名字))))))

; —— 中间件：洋葱模型。每个中间件拿到（上下文，下一步）：不调“下一步”直接返回＝提前返回；调之前改上下文＝改请求；
;    调之后拿到里面的响应再改＝处理后改响应。——
(模块 中间件 (用 错误们 响应 上下文)
  (宿主 sys.print ((话 文字) (通道 文字)) -> 空)
  ; “下一步”和中间件函数都是“要等”的：里面的处理函数可能要等。
  (公开 (别名 下一步 (要等函数 (上下文) 响应)))
  (公开 (别名 中间件函数 (要等函数 (上下文 (要等函数 (上下文) 响应)) 响应)))
  ; 中间件可以是实现了这个接口的对象，也可以直接是一个函数 (上下文 下一步)。
  (公开 (接口 中间件 (处理 ((c 上下文) (往下 下一步)) 响应 要等)))
  (函数 包一层 ((这一层 任意) (里面 下一步)) -> 下一步
    (如果 (是类 这一层 "function") (那么
      (设 f (转 中间件函数 这一层))
      (返回 (要等λ ((c 上下文)) (调 f c 里面)))))
    (设 m (转 中间件 这一层))
    (返回 (要等λ ((c 上下文)) (发 m 处理 c 里面))))
  ; 把一串中间件和最里面的处理函数套成一个函数：第一个在最外面。
  (公开 (函数 串起来 ((中间件们 (列表 任意)) (最里面 下一步)) -> 下一步
    (设 结果 最里面)
    (设 i (- (长 中间件们) 1))
    (当 (>= i 0)
      (改 结果 (调 包一层 (项 中间件们 i) 结果))
      (改 i (- i 1)))
    (返回 结果)))
  ; 现成的中间件：把里面抛出来的错误变成响应。HTTP错误 → 它自己的状态码和内容；别的错误 → 500。
  ; 别的错误默认记到错误输出；也可以给一个函数 (错误 上下文) 自己处理。
  (公开 (类 错误处理 (实现 中间件)
    (字段 出错时 (可空 (函数 (错误 上下文) 空)) 空)
    (创建 ((出错时 (可空 (函数 (错误 上下文) 空)) 空))
      (改字段 (这) 出错时 出错时))
    (要等方法 处理 ((c 上下文) (往下 下一步)) -> 响应
      (试 (做 (返回 (调 往下 c)))
          (出错时 HTTP错误 e
            (设 回复 (发 响应 JSON (. e 状态码) (标 任意 (发 e 变成内容))))
            (如果 (是 方式不对 e) (那么
              (做 (发 回复 加头 "Allow" (拼 (. (转 方式不对 e) 允许的) ", ")))))
            (返回 回复))
          (出错时 错误 e
            (设 自己处理 (. (这) 出错时))
            (如果 (是空 自己处理)
              (那么 (做 (宿 sys.print (连 "出错：" (. c 方式) " " (. c 路径) "：" (. e 消息)) "err")))
              (否则 (做 (调 (必有 自己处理) e c))))
            (返回 (发 响应 JSON 500 (标 任意 (典 ("error" "服务器内部出错")))))))
      (返回 (发 响应 空的))))))

; —— 路由和应用：路由器（可以分组、带前缀、各组有自己的中间件）＋应用（接到宿主上）。——
(模块 路由 (用 错误们 响应 上下文 中间件)
  (宿主 http.serve ((端口 整数) (主机 文字) (处理 (要等函数 ((字典 任意)) (字典 任意)))) -> 空)
  (宿主 sys.env ((名 文字)) -> (可空 文字))
  ; 处理函数返回什么都行：响应对象原样；空 → 204；文字 → 文字响应；别的 → JSON 响应。
  (公开 (别名 处理函数 (要等函数 (上下文) 任意)))
  (记录 路由 (方式 文字) (段们 (列表 文字)) (处理 处理函数))
  (函数 切路径 ((路径 文字)) -> (列表 文字)
    (设 段们 (列表 文字) (列))
    (每个 段 (切 路径 "/")
      (如果 (!= 段 "") (那么 (加项 段们 段))))
    (返回 段们))
  (函数 变成响应 ((值 任意)) -> 响应
    (如果 (是 响应 值) (那么 (返回 (转 响应 值))))
    (如果 (是空 值) (那么 (返回 (发 响应 空的))))
    (如果 (是类 值 "text") (那么 (返回 (发 响应 文字 200 值))))
    (返回 (发 响应 JSON 200 值)))
  (公开 (类 路由器 可继承
    (字段 前缀段 (列表 文字) (列))
    (字段 上级 (可空 路由器) 空)
    (字段 中间件们 (列表 任意) (列))
    (字段 路由们 (列表 路由) (列))
    (字段 分组们 (列表 路由器) (列))
    (创建 ((前缀 文字 "") (上级 (可空 路由器) 空))
      (改字段 (这) 前缀段 (调 切路径 前缀))
      (如果 (非空 上级) (那么
        (改字段 (这) 前缀段 (接 (. (必有 上级) 前缀段) (. (这) 前缀段)))))
      (改字段 (这) 上级 上级))
    ; 加一个中间件（只管这个路由器和它下面的分组）：实现了“中间件”的对象，或者一个中间件函数。
    (方法 用 ((一个中间件 任意)) -> 路由器
      (加项 (. (这) 中间件们) 一个中间件)
      (返回 (这)))
    ; 开一个分组：路径带上前缀，可以有自己的中间件。
    (方法 分组 ((前缀 文字)) -> 路由器
      (设 组 (新 路由器 前缀 (这)))
      (加项 (. (这) 分组们) 组)
      (返回 组))
    (方法 加 ((方式 文字) (路径 文字) (处理 处理函数)) -> 路由器
      (加项 (. (这) 路由们) (新记 路由 (方式 方式) (段们 (接 (. (这) 前缀段) (调 切路径 路径))) (处理 处理)))
      (返回 (这)))
    (方法 GET ((路径 文字) (处理 处理函数)) -> 路由器 (返回 (发 (这) 加 "GET" 路径 处理)))
    (方法 POST ((路径 文字) (处理 处理函数)) -> 路由器 (返回 (发 (这) 加 "POST" 路径 处理)))
    (方法 PUT ((路径 文字) (处理 处理函数)) -> 路由器 (返回 (发 (这) 加 "PUT" 路径 处理)))
    (方法 PATCH ((路径 文字) (处理 处理函数)) -> 路由器 (返回 (发 (这) 加 "PATCH" 路径 处理)))
    (方法 DELETE ((路径 文字) (处理 处理函数)) -> 路由器 (返回 (发 (这) 加 "DELETE" 路径 处理)))
    ; 从最上面的路由器到自己，一路上的中间件（不含最上面那个的——它的在最外层，已经跑过了）。
    (方法 一路的中间件 () -> (列表 任意)
      (设 上 (. (这) 上级))
      (如果 (是空 上) (那么 (返回 (标 (列表 任意) (列)))))
      (返回 (接 (发 (必有 上) 一路的中间件) (. (这) 中间件们))))
    ; 自己和下面所有分组的路由，摊平成一个列表：每项记着路由和它所在的路由器。
    (方法 全部路由 () -> (列表 路由项)
      (设 全部 (列表 路由项) (列))
      (每个 一条 (. (这) 路由们)
        (加项 全部 (新记 路由项 (路由 一条) (路由器 (这)))))
      (每个 组 (. (这) 分组们)
        (改 全部 (接 全部 (发 组 全部路由))))
      (返回 全部))))
  (记录 路由项 (路由 路由) (路由器 路由器))
  (函数 对得上 ((模式 (列表 文字)) (段们 (列表 文字))) -> (可空 (字典 文字))
    (如果 (!= (长 模式) (长 段们)) (那么 (返回 空)))
    (设 参数 (字典 文字) (典))
    (数 i 0 (长 模式)
      (设 想要 (项 模式 i))
      (设 实际 (项 段们 i))
      (如果 (开头是 想要 ":")
        (那么 (存 参数 (截 想要 1 (文长 想要)) 实际))
        (否则 (如果 (!= 想要 实际) (那么 (返回 空))))))
    (返回 参数))
  ; 端口先看环境变量 PORT（1 到 5 位数字、不超过 65535），没有才用程序里写的；主机看 HOST，没有就是 0.0.0.0。
  ; （C 分册 9.1：这两样从宿主搬到库里。）
  (函数 用哪个端口 ((写的 整数)) -> 整数
    (设 给的 (宿 sys.env "PORT"))
    (如果 (是空 给的) (那么 (返回 写的)))
    (设 文 (必有 给的))
    (如果 (或 (< (文长 文) 1) (> (文长 文) 5)) (那么 (返回 写的)))
    (每个 码 (码点们 文)
      (如果 (或 (< 码 48) (> 码 57)) (那么 (返回 写的))))
    (设 数 (或空 (解析整数 文) 写的))
    (如果 (> 数 65535) (那么 (返回 写的)))
    (返回 数))
  (公开 (类 应用 (继承 路由器)
    (创建 () (父创建))
    ; 最里面那一层：找路由，找不到就抛 404 / 405（外面的中间件接得到），找到就跑“分组的中间件 → 处理函数”。
    (要等方法 找并处理 ((c 上下文)) -> 响应
      (设 允许的 (列表 文字) (列))
      (每个 一项 (发 (这) 全部路由)
        (设 一条 (. 一项 路由))
        (设 参数 (调 对得上 (. 一条 段们) (. c 段们)))
        (如果 (是空 参数) (那么 (继续)))
        (如果 (!= (. 一条 方式) (. c 方式)) (那么
          (如果 (非 (列有 允许的 (. 一条 方式))) (那么 (加项 允许的 (. 一条 方式))))
          (继续)))
        (改字段 c 路径参数们 (必有 参数))
        (设 处理 (. 一条 处理))
        (设 链 (调 串起来 (发 (. 一项 路由器) 一路的中间件)
          (要等λ ((里 上下文)) (调 变成响应 (调 处理 里)))))
        (返回 (调 链 c)))
      (如果 (> (长 允许的) 0) (那么 (抛出 (新 方式不对 允许的))))
      (抛出 (新 没有这个)))
    ; 宿主每来一个请求调一次。
    (要等方法 处理请求 ((请求 (字典 任意))) -> (字典 任意)
      (设 自己 (这))
      (设 链 (调 串起来 (. (这) 中间件们) (要等λ ((c 上下文)) (发 自己 找并处理 c))))
      (设 回复 (发 响应 空的))
      (试 (做 (改 回复 (调 链 (新 上下文 请求))))
          ; 最后的兜底：没用“错误处理”中间件、或者中间件自己出了错。
          (出错时 错误 _ (改 回复 (发 响应 JSON 500 (标 任意 (典 ("error" "服务器内部出错")))))))
      (返回 (发 回复 变成字典)))
    (要等方法 开始服务 ((端口 整数))
      (设 自己 (这))
      (做 (宿 http.serve (调 用哪个端口 端口) (或空 (宿 sys.env "HOST") "0.0.0.0")
        (要等λ ((请求 (字典 任意))) (发 自己 处理请求 请求))))))))

; —— 请求校验助手：一条条登记规则，最后“检查”——有问题就抛“校验没过”（422，详情里列出每个问题）。
;    每条规则是一个函数 (数据) → 问题文字，没问题返回空。规则靠闭包记住自己的字段名和范围。——
(模块 校验 (用 错误们)
  (公开 (别名 规则函数 (函数 ((字典 任意)) (可空 文字))))
  (公开 (类 校验器
    (字段 规则们 (列表 规则函数) (列))
    (方法 规则 ((一条 规则函数)) -> 校验器
      (加项 (. (这) 规则们) 一条)
      (返回 (这)))
    (方法 必填 ((字段 文字)) -> 校验器
      (返回 (发 (这) 规则 (λ块 ((数据 (字典 任意)))
        (如果 (是空 (取 数据 字段)) (那么 (返回 (标 (可空 文字) (连 字段 " 必须填")))))
        (返回 (标 (可空 文字) 空))))))
    ; 是文字，长度在 最短–最长 之间（没填的不管，交给“必填”）。
    (方法 文字 ((字段 文字) (最短 整数) (最长 整数)) -> 校验器
      (返回 (发 (这) 规则 (λ块 ((数据 (字典 任意)))
        (设 值 (取 数据 字段))
        (如果 (是空 值) (那么 (返回 (标 (可空 文字) 空))))
        (如果 (非 (是类 值 "text")) (那么 (返回 (标 (可空 文字) (连 字段 " 要是文字")))))
        (设 多长 (文长 (转 文字 值)))
        (如果 (或 (< 多长 最短) (> 多长 最长)) (那么
          (返回 (标 (可空 文字) (连 字段 " 的长度要在 " 最短 " 到 " 最长 " 之间")))))
        (返回 (标 (可空 文字) 空))))))
    (方法 数字 ((字段 文字) (最小 整数) (最大 整数)) -> 校验器
      (返回 (发 (这) 规则 (λ块 ((数据 (字典 任意)))
        (设 值 (取 数据 字段))
        (如果 (是空 值) (那么 (返回 (标 (可空 文字) 空))))
        (如果 (非 (是类 值 "number")) (那么 (返回 (标 (可空 文字) (连 字段 " 要是数字")))))
        (如果 (或 (任< 值 最小) (任> 值 最大)) (那么
          (返回 (标 (可空 文字) (连 字段 " 要在 " 最小 " 到 " 最大 " 之间")))))
        (返回 (标 (可空 文字) 空))))))
    (方法 其中之一 ((字段 文字) (可选的 (列表 文字))) -> 校验器
      (返回 (发 (这) 规则 (λ块 ((数据 (字典 任意)))
        (设 值 (取 数据 字段))
        (如果 (是空 值) (那么 (返回 (标 (可空 文字) 空))))
        (如果 (或 (非 (是类 值 "text")) (非 (列有 可选的 (转 文字 值)))) (那么
          (返回 (标 (可空 文字) (连 字段 " 只能是 " (拼 可选的 "、") " 里的一个")))))
        (返回 (标 (可空 文字) 空))))))
    ; 数据要是字典；跑完所有规则，把问题收齐了一起报。没问题就返回数据。
    (方法 检查 ((数据 任意)) -> (字典 任意)
      (如果 (非 (是类 数据 "dict")) (那么
        (抛出 (新 校验没过 (列 "提交的内容要是一个 JSON 对象")))))
      (设 表 (转 (字典 任意) 数据))
      (设 问题们 (列表 文字) (列))
      (每个 一条 (. (这) 规则们)
        (设 问题 (调 一条 表))
        (如果 (非空 问题) (那么 (加项 问题们 (必有 问题)))))
      (如果 (> (长 问题们) 0) (那么 (抛出 (新 校验没过 问题们))))
      (返回 表))))
  ; 把文字写的编号变成数字；不是数字就抛 400。“1.0”“1e3”“ 7 ”都认。
  (公开 (函数 要数字 ((话 (可空 文字)) (名字 文字)) -> 小数
    (如果 (非 (是数字 话)) (那么
      (抛出 (新 请求不对 (连 名字 " 要是数字")))))
    (返回 (转数 (必有 话))))))

; —— 仓库：一类东西的增删改查，数据放在宿主的格子里。改数据都走“改格子”——“取出来 → 改 → 放回去”一口气做完。——
(模块 仓库
  (宿主 store.read ((名 文字)) -> 任意)
  (宿主 store.update ((名 文字) (改法 (函数 (任意) 任意))) -> 任意)
  (公开 (类 仓库
    (字段 名字 文字 "")
    (创建 ((名字 文字))
      (改字段 (这) 名字 名字))
    (方法 格子 () -> 文字
      (返回 (连 "仓库:" (. (这) 名字))))
    ; 改法：函数(库)，直接在库上改；库是 {next, rows}。
    (方法 改库 ((改法 (函数 ((字典 任意)) 空)))
      (做 (宿 store.update (发 (这) 格子) (λ块 ((旧 任意))
        (设 库 (字典 任意) (典 ("next" 1) ("rows" (标 (列表 任意) (列)))))
        (如果 (非空 旧) (那么 (改 库 (转 (字典 任意) 旧))))
        (做 (调 改法 库))
        (返回 (标 任意 库))))))
    (方法 全部 () -> (列表 任意)
      (设 库 (宿 store.read (发 (这) 格子)))
      (如果 (是空 库) (那么 (返回 (标 (列表 任意) (列)))))
      (返回 (转 (列表 任意) (取 (转 (字典 任意) 库) "rows"))))
    (方法 取 ((id 小数)) -> 任意
      (返回 (找 (发 (这) 全部) (λ ((行 任意)) (== (取 (转 (字典 任意) 行) "id") (标 任意 id))))))
    (方法 加 ((内容 (字典 任意))) -> (字典 任意)
      (设 结果 (字典 任意) (典))
      (做 (发 (这) 改库 (λ块 ((库 (字典 任意)))
        (设 号 (取 库 "next"))
        (改 结果 (合并 内容 (典 ("id" 号))))
        (存 库 "next" (任+ 号 1))
        (加项 (转 (列表 任意) (取 库 "rows")) (标 任意 结果)))))
      (返回 结果))
    (方法 改 ((id 小数) (内容 (字典 任意))) -> 任意
      (设 结果 任意 空)
      (做 (发 (这) 改库 (λ块 ((库 (字典 任意)))
        (设 行们 (转 (列表 任意) (取 库 "rows")))
        (数 i 0 (长 行们)
          (设 行 (转 (字典 任意) (项 行们 i)))
          (如果 (== (取 行 "id") (标 任意 id)) (那么
            (改 结果 (标 任意 (合并 (合并 行 内容) (典 ("id" (标 任意 id))))))
            (改项 行们 i 结果)))))))
      (返回 结果))
    (方法 删 ((id 小数)) -> 是否
      (设 删了 否)
      (做 (发 (这) 改库 (λ块 ((库 (字典 任意)))
        (设 行们 (转 (列表 任意) (取 库 "rows")))
        (设 剩下 (调 筛选 行们 (λ ((行 任意)) (!= (取 (转 (字典 任意) 行) "id") (标 任意 id)))))
        (改 删了 (!= (长 剩下) (长 行们)))
        (存 库 "rows" (标 任意 剩下)))))
      (返回 删了)))))

; —— 示例服务“小书店”——
;   最外层中间件：记日志 → 错误处理（HTTP错误变响应，别的错误变 500）→ 预检（提前返回）
;   /api 分组：鉴权中间件（改请求：把“用户”放进上下文）；下面两个资源：书 /api/books、作者 /api/authors
;   出错路由：/boom（抛文字）、/boom/teapot（抛自定义错误）、/boom/lib（小库抛的错）
(模块 书店服务 (用 错误们 响应 上下文 中间件 路由 校验 仓库)
  (宿主 time.sleep ((毫秒 整数)) -> 空)
  (宿主 time.now () -> 整数)
  (宿主 sys.print ((话 文字) (通道 文字)) -> 空)
  (宿主 store.update ((名 文字) (改法 (函数 (任意) 任意))) -> 任意)
  (变量 app 应用 (新 应用))
  (变量 书们 仓库 (新 仓库 "books"))
  (变量 作者们 仓库 (新 仓库 "authors"))
  ; —— 自己定义的错误：继承库里的 HTTP错误，改写“变成内容” ——
  (类 不许 (继承 HTTP错误)
    (字段 需要 文字 "")
    (创建 ((需要 文字))
      (父创建 403 "这件事只有管理员能做")
      (改字段 (这) 需要 需要))
    (方法 变成内容 () -> (字典 任意)
      (设 内容 (父 变成内容))
      (存 内容 "need" (. (这) 需要))
      (返回 内容)))
  (类 茶壶 (继承 HTTP错误)
    (创建 () (父创建 418 "我是茶壶"))
    (方法 变成内容 () -> (字典 任意)
      (返回 (合并 (父 变成内容) (典 ("tea" "龙井"))))))
  ; —— 中间件一：记日志（函数写的）。处理完以后才知道状态码；顺手给响应加一个头（处理后改响应）。
  ;    第几个请求记在格子里（请求之间要留住的东西放格子，C 分册 9.1）。——
  (要等函数 记日志 ((c 上下文) (往下 下一步)) -> 响应
    (设 号 (转 整数 (宿 store.update "请求数" (λ ((旧 任意)) (任+ (或空 旧 (标 任意 0)) 1)))))
    (设 开始 (宿 time.now))
    (设 回复 (调 往下 c))
    ; 耗时每次不一样，写到错误输出（不参加逐字节对比）。
    (做 (宿 sys.print (连 "#" 号 " 用了 " (- (宿 time.now) 开始) " 毫秒") "err"))
    (打印 (连 "#" 号 " " (. c 方式) " " (. c 路径) " → " (. 回复 状态码)))
    (返回 (发 回复 加头 "X-Request-Id" (文 号))))
  ; —— 中间件二：预检（类写的）。OPTIONS 请求不往里走，直接回（提前返回）。——
  (类 预检 (实现 中间件)
    (要等方法 处理 ((c 上下文) (往下 下一步)) -> 响应
      (如果 (== (. c 方式) "OPTIONS") (那么
        (返回 (发 (发 响应 空的) 加头 "Allow" "GET, POST, PUT, DELETE"))))
      (返回 (调 往下 c))))
  ; —— 中间件三：鉴权（类写的，带自己的数据）。认出是谁就放进上下文（改请求），认不出就抛“未授权”。——
  (类 鉴权 (实现 中间件)
    (内部字段 钥匙们 (字典 (字典 文字)) (典))
    (创建 ((钥匙们 (字典 (字典 文字))))
      (改字段 (这) 钥匙们 钥匙们))
    (要等方法 处理 ((c 上下文) (往下 下一步)) -> 响应
      (设 头 (发 c 请求头 "Authorization"))
      (如果 (或 (是空 头) (非 (开头是 (或空 头 "") "Bearer "))) (那么
        (抛出 (新 未授权))))
      (设 话 (必有 头))
      (设 用户 (取 (. (这) 钥匙们) (截 话 7 (文长 话))))
      (如果 (是空 用户) (那么 (抛出 (新 未授权 "钥匙不对"))))
      (做 (发 c 放 "用户" (标 任意 (必有 用户))))
      (返回 (调 往下 c))))
  (函数 用户的 ((c 上下文) (键 文字)) -> 任意
    (返回 (取 (转 (字典 任意) (发 c 取 "用户")) 键)))
  (函数 要管理员 ((c 上下文))
    (如果 (!= (调 用户的 c "role") (标 任意 "admin")) (那么
      (抛出 (新 不许 "admin")))))
  (函数 书的校验 ((新建 是否)) -> 校验器
    (设 v (新 校验器))
    (如果 新建 (那么 (做 (发 (发 v 必填 "title") 必填 "year"))))
    (做 (发 (发 (发 v 文字 "title" 1 40) 数字 "year" 1000 2100) 其中之一 "tag" (列 "科幻" "文学" "未分类")))
    (返回 v))
  (函数 找书 ((c 上下文)) -> (字典 任意)
    (设 书 (发 书们 取 (调 要数字 (发 c 路径参数 "id") "id")))
    (如果 (是空 书) (那么 (抛出 (新 没有这个 "没有这本书"))))
    (返回 (转 (字典 任意) 书)))
  (主
    (做 (发 app 用 (标 任意 记日志)))
    (做 (发 app 用 (标 任意 (新 错误处理))))
    (做 (发 app 用 (标 任意 (新 预检))))
    ; 原型里用库的积木外观写的那个接口（当收到 / 回复JSON / 路径参数），照展开以后的样子写。
    (做 (发 app 加 "GET" "/hello/:name" (λ ((c 上下文))
      (标 任意 (发 响应 JSON 200 (标 任意 (典 ("hello" (发 c 路径参数 "name")))))))))
    ; —— 不用登录的 ——
    (做 (发 app GET "/" (λ ((c 上下文)) (标 任意 "小书店"))))
    (做 (发 app GET "/health" (λ ((c 上下文))
      (标 任意 (典 ("ok" (标 任意 是)) ("books" (标 任意 (长 (发 书们 全部)))))))))
    ; —— 出错路由 ——
    (做 (发 app GET "/boom" (λ块 ((c 上下文)) (抛出 "炸了"))))
    (做 (发 app GET "/boom/teapot" (λ块 ((c 上下文)) (抛出 (新 茶壶)))))
    (做 (发 app GET "/boom/lib" (λ块 ((c 上下文))
      (改项 (标 (列表 整数) (列)) 5 1)
      (返回 (标 任意 "不该到这里")))))
    ; —— 要等的 ——
    (做 (发 app GET "/slow" (要等λ块 ((c 上下文))
      (做 (宿 time.sleep 30))
      (返回 (标 任意 (典 ("slept" 30)))))))
    (做 (发 app GET "/parallel" (要等λ块 ((c 上下文))
      (设 甲 (开始做块 (做 (宿 time.sleep 20)) (返回 1)))
      (设 乙 (开始做块 (做 (宿 time.sleep 10)) (返回 2)))
      (返回 (标 任意 (典 ("sum" (+ (等 甲) (等 乙)))))))))
    ; —— /api：要登录 ——
    (设 api (发 app 分组 "/api"))
    (做 (发 api 用 (标 任意 (新 鉴权 (典
      ("k-ming" (典 ("name" "小明") ("role" "admin")))
      ("k-hong" (典 ("name" "小红") ("role" "reader"))))))))
    (做 (发 api GET "/me" (λ ((c 上下文)) (发 c 取 "用户"))))
    ; 资源一：书
    (做 (发 api GET "/books" (λ块 ((c 上下文))
      (设 标签 (发 c 网址参数 "tag"))
      (如果 (是空 标签) (那么 (返回 (标 任意 (发 书们 全部)))))
      (返回 (标 任意 (调 筛选 (发 书们 全部) (λ ((书 任意)) (== (取 (转 (字典 任意) 书) "tag") (标 任意 标签)))))))))
    (做 (发 api POST "/books" (λ块 ((c 上下文))
      (设 数据 (发 (调 书的校验 是) 检查 (发 c 内容)))
      (设 书 (发 书们 加 (典
        ("title" (取 数据 "title"))
        ("year" (取 数据 "year"))
        ("tag" (或空 (取 数据 "tag") (标 任意 "未分类")))
        ("by" (调 用户的 c "name")))))
      (返回 (标 任意 (发 (发 响应 JSON 201 (标 任意 书)) 加头 "Location" (连 "/api/books/" (取 书 "id"))))))))
    (做 (发 api GET "/books/:id" (λ ((c 上下文)) (标 任意 (调 找书 c)))))
    (做 (发 api PUT "/books/:id" (λ块 ((c 上下文))
      (设 书 (调 找书 c))
      (设 数据 (发 (调 书的校验 否) 检查 (发 c 内容)))
      (设 改动 (字典 任意) (典))
      (每个 键 (列 "title" "year" "tag")
        (如果 (有键 数据 键) (那么 (存 改动 键 (取 数据 键)))))
      (返回 (发 书们 改 (转 小数 (取 书 "id")) 改动)))))
    (做 (发 api DELETE "/books/:id" (λ块 ((c 上下文))
      (做 (调 要管理员 c))
      (设 书 (调 找书 c))
      (做 (发 书们 删 (转 小数 (取 书 "id"))))
      (返回 (标 任意 空)))))
    ; 资源二：作者——再下一层的分组，有自己的中间件（处理后给响应加一个头）
    (设 作者组 (发 api 分组 "/authors"))
    (做 (发 作者组 用 (标 任意 (标 中间件函数 (要等λ ((c 上下文) (往下 下一步))
      (发 (调 往下 c) 加头 "X-Group" "authors"))))))
    (做 (发 作者组 GET "/" (λ ((c 上下文)) (标 任意 (发 作者们 全部)))))
    (做 (发 作者组 POST "/" (λ块 ((c 上下文))
      (设 数据 (发 (发 (发 (新 校验器) 必填 "name") 文字 "name" 1 20) 检查 (发 c 内容)))
      (返回 (标 任意 (发 响应 JSON 201 (标 任意 (发 作者们 加 (典 ("name" (取 数据 "name")))))))))))
    (做 (发 app 开始服务 8200))))
