; w10 函数值：要等的函数放进变量、列表、字段、当返回值，调它们照样等得对；小库的口（映射、筛选）里放不用等的函数照常。
(宿主 time.sleep ((毫秒 整数)) -> 空)
(函数 歇加 ((n 整数)) -> 整数 (做 (宿 time.sleep 1)) (返回 (+ n 1)))
(函数 翻倍 ((n 整数)) -> 整数 (返回 (* n 2)))
(函数 挑 ((慢 是否)) -> (函数 (整数) 整数)
  (如果 慢 (那么 (返回 歇加)))
  (返回 翻倍))
(类 步骤
  (字段 做法 (函数 (整数) 整数) 翻倍)
  (创建 ((做法 (函数 (整数) 整数))) (改字段 (这) 做法 做法))
  (方法 走 ((n 整数)) -> 整数 (设 f (. (这) 做法)) (返回 (调 f n))))
(函数 挨个做 ((步们 (列表 (函数 (整数) 整数))) (n 整数)) -> 整数
  (设 现在 n)
  (每个 f 步们 (改 现在 (调 f 现在)))
  (返回 现在))
(主
  (设 f (调 挑 是))
  (设 g (调 挑 否))
  (打印 (调 f 1))
  (打印 (调 g 1))
  (打印 (调 挨个做 (列 歇加 翻倍 歇加 (λ ((x 整数)) (- x 3))) 5))
  (打印 (发 (新 步骤 歇加) 走 9))
  (打印 (发 (新 步骤 翻倍) 走 9))
  (打印 (拼 (调 映射 (调 筛选 (列 1 2 3 4 5 6) (λ ((x 整数)) (== (余 x 2) 0))) (λ ((x 整数)) (文 (调 翻倍 x)))) ","))
  (设 结果们 (标 (列表 整数) (列)))
  (每个 x (列 1 2 3) (加项 结果们 (调 歇加 x)))
  (打印 (拼 (调 映射 结果们 (λ ((x 整数)) (文 x))) ","))
  (设 t (开始做 (λ () (调 f 41))))
  (打印 (等 t)))
