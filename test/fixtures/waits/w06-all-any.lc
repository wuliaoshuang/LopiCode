; w06 等全部、等最先的一个。等全部：结果按列表的顺序；有一件出错＝别的还没做完的被取消，错抛出来。等最先：谁先做完用谁的，别的接着做。
(宿主 time.sleep ((毫秒 整数)) -> 空)
(函数 干 ((毫秒 整数) (n 整数)) -> 整数 (做 (宿 time.sleep 毫秒)) (返回 n))
(函数 坏 ((毫秒 整数)) -> 整数 (做 (宿 time.sleep 毫秒)) (抛出 "半路坏了") (返回 0))
(函数 开 ((毫秒 整数) (n 整数)) -> (稍后 整数) (返回 (开始做块 (返回 (调 干 毫秒 n)))))
(函数 说 ((t (稍后 整数))) -> 文字
  (试 (做 (返回 (连 "结果 " (等 t))))
      (出错时 取消了 e (返回 (连 "被取消：" (. e 消息))))
      (出错时 _ e (返回 (连 "出错：" (. e 消息))))))
(主
  (设 全 (等全部 (列 (调 开 300 1) (调 开 20 2) (调 开 150 3))))
  (打印 (拼 (调 映射 全 (λ ((x 整数)) (文 x))) ","))
  (打印 (长 (等全部 (标 (列表 (稍后 整数)) (列)))))
  (打印 (等最先 (列 (调 开 600 1) (调 开 50 2) (调 开 300 3))))
  ; 一件出错：先做完的那件不受影响，还在做的那件被取消
  (设 快 (调 开 20 7))
  (设 慢 (调 开 900 8))
  (设 会坏 (开始做块 (返回 (调 坏 250))))
  (试 (做 (打印 (长 (等全部 (列 快 慢 会坏)))))
      (出错时 _ e (打印 (连 "等全部没成：" (. e 消息)))))
  (打印 (调 说 快))
  (打印 (调 说 慢))
  (打印 (调 说 会坏))
  ; 最先做完的那件是出错的：拿到的就是它的错
  (试 (做 (打印 (等最先 (列 (调 开 700 1) (开始做块 (返回 (调 坏 30)))))))
      (出错时 _ e (打印 (连 "最先的那件出错了：" (. e 消息)))))
  (试 (做 (打印 (等最先 (标 (列表 (稍后 整数)) (列)))))
      (出错时 _ e (打印 (. e 消息)))))
