; w02 跨模块的推断：要等的事在最里面的模块，调它的模块一层层都推成要等；没碰它的函数不等。
(模块 底
  (宿主 time.sleep ((毫秒 整数)) -> 空)
  (公开 (函数 歇一下 ((话 文字)) -> 文字 (做 (宿 time.sleep 1)) (返回 (连 话 "~"))))
  (公开 (函数 直接给 ((话 文字)) -> 文字 (返回 (连 话 "."))))
  (公开 (类 慢仓库
    (字段 货 (列表 文字) (列))
    (方法 放 ((x 文字)) -> 整数 (做 (宿 time.sleep 1)) (加项 (. (这) 货) x) (返回 (长 (. (这) 货))))
    (方法 几件 () -> 整数 (返回 (长 (. (这) 货)))))))
(模块 中 (用 底)
  (公开 (函数 转手 ((话 文字)) -> 文字 (返回 (连 "<" (调 歇一下 话) ">"))))
  (公开 (函数 也转手 ((话 文字)) -> 文字 (返回 (连 "<" (调 直接给 话) ">")))))
(模块 主程序 (用 中 底)
  (函数 进货 ((仓 慢仓库) (名 文字)) -> 文字 (返回 (连 名 " 是第 " (发 仓 放 名) " 件")))
  (主
    (打印 (调 转手 "甲"))
    (打印 (调 也转手 "乙"))
    (设 仓 (新 慢仓库))
    (打印 (调 进货 仓 "米"))
    (打印 (调 进货 仓 "面"))
    (打印 (发 仓 几件))
    (设 t (开始做块 (返回 (调 转手 "丙"))))
    (打印 (等 t))))
