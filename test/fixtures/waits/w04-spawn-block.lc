; w04 “开始做”里面写几句话：用得到外面的变量；没有返回值的也行；里面出的错先记着，等它的时候才抛，能按种类接；等两次拿到同一个结果。
(宿主 time.sleep ((毫秒 整数)) -> 空)
(类 没货 (继承 错误) (创建 ((名 文字)) (父创建 (连 名 " 没货了"))))
(函数 查货 ((名 文字)) -> 整数
  (做 (宿 time.sleep 5))
  (如果 (== 名 "梨") (那么 (抛出 (新 没货 名))))
  (返回 (长 名)))
(函数 开查 ((名 文字)) -> (稍后 整数) (返回 (开始做块 (返回 (调 查货 名)))))
(主
  (设 基数 100)
  (设 账 (标 (列表 文字) (列)))
  (设 t1 (开始做块 (做 (宿 time.sleep 20)) (返回 (+ 基数 1))))
  (设 t2 (开始做块 (加项 账 "记了一笔")))
  (设 t3 (开始做块 (设 自己的 0) (数 i 0 5 (改 自己的 (+ 自己的 i))) (返回 (连 "和是 " 自己的))))
  (打印 (等 t1))
  (做 (等 t2))
  (打印 (拼 账 ","))
  (打印 (等 t3))
  (打印 (等 t1))
  (设 好 (调 开查 "苹果"))
  (设 坏 (调 开查 "梨"))
  (打印 (等 好))
  (试 (做 (打印 (等 坏)))
      (出错时 没货 e (打印 (连 "接到没货：" (. e 消息))))
      (最后 (打印 "查完")))
  (试 (做 (打印 (等 坏)))
      (出错时 _ e (打印 (连 "再等一次还是：" (. e 消息)))))
  (设 一串 (标 (列表 (稍后 整数)) (列)))
  (数 i 0 4 (设 n i) (加项 一串 (开始做块 (做 (宿 time.sleep (* (- 4 n) 10))) (返回 (* n n)))))
  (设 总 0)
  (每个 t 一串 (改 总 (+ 总 (等 t))))
  (打印 (连 "平方和 " 总)))
