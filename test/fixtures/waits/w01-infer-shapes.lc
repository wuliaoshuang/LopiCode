; w01 推断的各种形状：谁都没标“要等”，全靠推——函数、方法、匿名函数、互相调用、递归、接口实现、重写、当参数传的函数。
(宿主 time.sleep ((毫秒 整数)) -> 空)
(函数 歇 ((话 文字)) -> 文字 (做 (宿 time.sleep 1)) (返回 (连 话 "·歇过")))
(函数 外 ((话 文字)) -> 文字 (返回 (连 "[" (调 歇 话) "]")))
(函数 不等 ((n 整数)) -> 整数 (返回 (* n 2)))
; 互相调用：单 ↔ 双，里面有一处要等，两个都算要等
(函数 单 ((n 整数)) -> 文字
  (如果 (== n 0) (那么 (返回 "到底")))
  (返回 (连 "单" (调 双 (- n 1)))))
(函数 双 ((n 整数)) -> 文字
  (如果 (== n 0) (那么 (返回 (调 歇 "底"))))
  (返回 (连 "双" (调 单 (- n 1)))))
; 自己调自己
(函数 数下去 ((n 整数)) -> 整数
  (如果 (<= n 0) (那么 (做 (宿 time.sleep 1)) (返回 0)))
  (返回 (+ n (调 数下去 (- n 1)))))
(接口 会干活 (干 ((活 文字)) 文字))
(类 慢工 可继承 (实现 会干活)
  (字段 名 文字 "")
  (创建 ((名 文字)) (改字段 (这) 名 名))
  (方法 干 ((活 文字)) -> 文字 (做 (宿 time.sleep 1)) (返回 (连 (. (这) 名) " 慢慢干完了 " 活))))
(类 快工 (实现 会干活)
  (方法 干 ((活 文字)) -> 文字 (返回 (连 "快工 马上干完了 " 活))))
(类 学徒 (继承 慢工)
  (创建 () (父创建 "学徒"))
  (方法 干 ((活 文字)) -> 文字 (返回 (连 (父 干 活) "（师傅看过）"))))
(函数 派活 ((谁 会干活) (活 文字)) -> 文字 (返回 (发 谁 干 活)))
; 收一个函数当参数：传进来的要等，它就要等
(函数 做两遍 ((f (函数 (文字) 文字)) (话 文字)) -> 文字 (返回 (连 (调 f 话) "+" (调 f 话))))
(主
  (打印 (调 外 "甲"))
  (打印 (调 不等 21))
  (打印 (调 单 3))
  (打印 (调 双 3))
  (打印 (调 数下去 4))
  (设 工们 (标 (列表 会干活) (列 (新 慢工 "老张") (新 快工) (新 学徒))))
  (每个 工 工们 (打印 (调 派活 工 "砌墙")))
  (设 匿名 (λ ((话 文字)) (调 歇 话)))
  (打印 (调 匿名 "乙"))
  (打印 (调 做两遍 匿名 "丙"))
  (打印 (调 做两遍 (λ ((话 文字)) (连 话 "!")) "丁"))
  (设 块 (λ块 ((n 整数)) (做 (宿 time.sleep 1)) (返回 (+ n 1))))
  (打印 (调 块 41)))
