; w05 超时：“等，最多 N 毫秒”——到时候还没做完就出“超时”错误（能按种类接）；那件事自己接着做，后面再等还拿得到结果。
(宿主 time.sleep ((毫秒 整数)) -> 空)
(函数 慢慢算 ((毫秒 整数) (n 整数)) -> 整数 (做 (宿 time.sleep 毫秒)) (返回 (* n n)))
(函数 限时算 ((毫秒 整数) (最多 整数) (n 整数)) -> 文字
  (设 t (开始做块 (返回 (调 慢慢算 毫秒 n))))
  (试 (做 (返回 (连 "算出 " (等最多 t 最多))))
      (出错时 超时 e (返回 (连 "超时：" (. e 消息))))))
(主
  (打印 (调 限时算 20 2000 7))
  (打印 (调 限时算 900 150 8))
  (设 慢 (开始做块 (返回 (调 慢慢算 600 9))))
  (试 (做 (打印 (等最多 慢 100)))
      (出错时 _ e (打印 (连 (. e 种类) "｜" (. e 消息)))))
  (试 (做 (打印 (等最多 慢 0)))
      (出错时 超时 e (打印 "马上看一眼：还没好")))
  (打印 (连 "接着等到了 " (等 慢)))
  (打印 (连 "做完以后再限时等 " (等最多 慢 0)))
  (设 会坏 (开始做块 (做 (宿 time.sleep 10)) (抛出 "里面坏了") (返回 1)))
  (试 (做 (打印 (等最多 会坏 2000)))
      (出错时 超时 e (打印 "不该是超时"))
      (出错时 _ e (打印 (连 "那件事自己的错：" (. e 消息))))))
