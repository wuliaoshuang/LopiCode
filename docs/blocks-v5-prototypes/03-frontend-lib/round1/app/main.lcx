; 03 的检查程序（第 1 轮）：把“状态库”和“事件总线库”的每条规矩走一遍，每条打印一行。
; 期望的输出是先手写好的（../expected.txt），Node 和 Python 的输出都要逐字节等于它。
(module 检查
  (uses 状态库 事件总线库)

  (func 报 (号 名字 值)
    (do (rt log (rt join "[" 号 "] " 名字 "：" 值))))

  ; —— 用积木外观写的两段（帽子型积木只能放在模块最外面；它们展开后排在“启动时”的最前面）——
  (var 积木计数 (@新状态 0))
  (var 积木记录 (list))
  (@当变了 (-> () (@状态的值 积木计数)) (口
    (do (rt listPush 积木记录 (rt join 旧值 "→" 新值)))))

  (var 全局总线 (new 事件总线))
  (var 积木收到的 (list))
  (@当收到事件 全局总线 "积木事件" (口
    (do (rt listPush 积木收到的 数据))))

  (main
    (let 错们 (list))
    (do (call 设出错时 (fn (消息) (do (rt listPush 错们 消息)))))

    ; ———— 状态 ————
    (let a (call 新状态 0))
    (do (send a 写 (+ (send a 读) 1)))
    (do (send a 写 (+ (send a 读) 1)))
    (do (call 报 "1" "先写后读，连加两次" (send a 读)))

    (let b (call 新状态 1))
    (let 两倍 (call 新派生 (-> () (* (send b 读) 2))))
    (let 文字 "")
    (let 写了几次 0)
    (let 停2 (call 跟着做 (fn ()
      (set 文字 (rt join "值是" (send 两倍 读)))
      (set 写了几次 (+ 写了几次 1)))))
    (do (call 报 "2.0" "跟着做：登记时马上做一次" (rt join 文字 "，" 写了几次)))
    (do (send b 写 5))
    (do (call 报 "2a" "改完马上读派生值，是新的" (send 两倍 读)))
    (do (call 报 "2b" "这一刻跟着做的还没跑" (rt join 文字 "，" 写了几次)))
    (do (send b 写 6))
    (do (send b 写 7))
    (do (call 等更新))
    (do (call 报 "2c" "一段里改三次，只多跑一次" (rt join 文字 "，" 写了几次)))

    (let 甲 (call 新状态 1))
    (let 乙 (call 新派生 (-> () (+ (send 甲 读) 1))))
    (let 丙 (call 新派生 (-> () (* (send 甲 读) 10))))
    (let 见过的 (list))
    (let 丁 (call 新派生 (fn ()
      (let v (+ (send 乙 读) (send 丙 读)))
      (do (rt listPush 见过的 v))
      (return v))))
    (do (call 报 "3a" "菱形：第一次读丁" (send 丁 读)))
    (do (send 甲 写 2))
    (do (call 报 "3b" "菱形：改了甲以后读丁" (send 丁 读)))
    (do (call 报 "3c" "丁算出过的值（没有半新半旧的）" 见过的))
    (do (call 报 "3d" "丁一共算了几次" (. 丁 算了几次)))

    (let 开关 (call 新状态 true))
    (let 内容 (call 新状态 "A"))
    (let 跑4 0)
    (let 看到 "")
    (let 停4 (call 跟着做 (fn ()
      (set 跑4 (+ 跑4 1))
      (if (when (send 开关 读) (set 看到 (send 内容 读)))
          (else (set 看到 "关"))))))
    (do (send 内容 写 "B"))
    (do (call 等更新))
    (do (send 开关 写 false))
    (do (call 等更新))
    (do (send 内容 写 "C"))
    (do (call 等更新))
    (do (call 报 "4" "条件里的依赖关掉以后不再触发" (rt join 跑4 "，" 看到)))

    (let c (call 新状态 1))
    (let 跑5 0)
    (let 停5 (call 跟着做 (fn ()
      (do (send c 读))
      (set 跑5 (+ 跑5 1)))))
    (do (send c 写 1))
    (do (call 等更新))
    (do (call 报 "5a" "设成同一个值不触发" 跑5))
    (do (send c 写 "1"))
    (do (call 等更新))
    (do (call 报 "5b" "数字 1 换成文字“1”：算变了" 跑5))
    (let 表 (call 新状态 (list 1 2)))
    (let 跑5c 0)
    (let 停5c (call 跟着做 (fn ()
      (do (send 表 读))
      (set 跑5c (+ 跑5c 1)))))
    (do (send 表 写 (list 1 2)))
    (do (call 等更新))
    (do (call 报 "5c" "换成内容一样的另一个列表：算变了" 跑5c))
    (let 同一个 (send 表 偷看))
    (do (rt listPush 同一个 3))
    (do (send 表 写 同一个))
    (do (call 等更新))
    (do (call 报 "5d" "原地改了再写回同一个列表：不算变（已知的坑）" 跑5c))

    (let d (call 新状态 0))
    (let 记6 (list))
    (let 停6 (call 跟着做 (fn ()
      (let v (send d 读))
      (do (rt listPush 记6 (rt join "做" v)))
      (return (fn () (do (rt listPush 记6 (rt join "收" v))))))))
    (do (send d 写 1))
    (do (call 等更新))
    (do (call 停6))
    (do (send d 写 2))
    (do (call 等更新))
    (do (call 报 "6" "收尾函数：重做前叫、停掉时叫，停掉后不再做" 记6))

    (let e7 (call 新状态 0))
    (let 跑7 0)
    (let 停7 (call 跟着做 (fn ()
      (set 跑7 (+ 跑7 1))
      (do (send e7 写 (+ (send e7 读) 1))))))
    (do (call 等更新))
    (do (call 报 "7a" "跟着做的事改它自己看的状态：报错停下" 错们))
    (do (call 报 "7b" "它一共跑了几次" 跑7))
    (do (call 停7))

    (let 绕甲 null)
    (let 绕乙 null)
    (set 绕甲 (call 新派生 (-> () (+ (send 绕乙 读) 1))))
    (set 绕乙 (call 新派生 (-> () (+ (send 绕甲 读) 1))))
    (let 结果8 "没出错")
    (try
      (body (do (send 绕甲 读)))
      (catch e (set 结果8 (. e 消息))))
    (do (call 报 "8" "两个派生值互相绕" 结果8))

    ; ———— 当…变了 ————
    (let f (call 新状态 1))
    (let 记9 (list))
    (let 停9 (call 当变了 (-> () (send f 读)) (fn (新 旧) (do (rt listPush 记9 (rt join 旧 "→" 新))))))
    (do (call 报 "9a" "当…变了：登记时不先叫" 记9))
    (do (send f 写 2))
    (do (send f 写 3))
    (do (call 等更新))
    (do (call 报 "9b" "一轮里变多次只叫一次，拿到最后的值和原来的值" 记9))
    (do (send f 写 9))
    (do (send f 写 3))
    (do (call 等更新))
    (do (call 报 "9c" "变了又变回来：不叫" 记9))
    (let 记10 (list))
    (let 停10 (call 当变了 (-> () (send f 读)) (fn (新 旧) (do (rt listPush 记10 (rt join 旧 "→" 新)))) true))
    (do (call 报 "10" "“马上先做一次”（旧值是空）" 记10))
    (do (call 停9))
    (do (call 停10))
    (do (send f 写 4))
    (do (call 等更新))
    (do (call 报 "11" "取消以后不再叫" (rt join (rt size 记9) "，" (rt size 记10))))

    ; ———— 一起改 ————
    (let g (call 新状态 0))
    (let h (call 新状态 0))
    (let 记12 (list))
    (let 停12 (call 跟着做 (fn ()
      (do (rt listPush 记12 (rt join (send g 读) "+" (send h 读)))))))
    (do (call 一起改 (fn ()
      (do (send g 写 1))
      (do (call 等更新))
      (do (rt listPush 记12 "中间"))
      (do (send h 写 1)))))
    (do (call 等更新))
    (do (call 报 "12a" "一起改：中间等过，跟着做的也只跑一次" 记12))
    (do (send g 写 2))
    (do (call 等更新))
    (do (send h 写 2))
    (do (call 等更新))
    (do (call 报 "12b" "不用一起改：等一次跑一次" 记12))

    (let 坏派生 (call 新派生 (fn ()
      (do (send g 写 99))
      (return 1))))
    (let 结果13 "没出错")
    (try
      (body (do (send 坏派生 读)))
      (catch e (set 结果13 (. e 消息))))
    (do (call 报 "13a" "派生值的算法里改状态" 结果13))
    (do (call 报 "13b" "那个状态没被改" (send g 偷看)))

    ; ———— 归属 ————
    (let 主 (new 归属))
    (let i (call 新状态 0))
    (let 记14 (list))
    (do (send 主 里面做 (fn ()
      (do (call 跟着做 (fn ()
        (do (rt listPush 记14 (rt join "甲" (send i 读))))
        (return (fn () (do (rt listPush 记14 "甲收")))))))
      (do (call 跟着做 (fn ()
        (do (rt listPush 记14 (rt join "乙" (send i 读))))
        (return (fn () (do (rt listPush 记14 "乙收"))))))))))
    (do (send i 写 1))
    (do (call 等更新))
    (do (send 主 收))
    (do (send i 写 2))
    (do (call 等更新))
    (do (call 报 "14" "归属收了：里面的都停、收尾都叫（后建的先收）" 记14))

    (let j (call 新状态 0))
    (let 跑15 0)
    (let 停15 (call 跟着做 (fn ()
      (do (send j 偷看))
      (set 跑15 (+ 跑15 1)))))
    (let 跑15b 0)
    (let 停15b (call 跟着做 (fn ()
      (do (call 不记依赖地做 (-> () (send j 读))))
      (set 跑15b (+ 跑15b 1)))))
    (do (send j 写 1))
    (do (call 等更新))
    (do (call 报 "15" "偷看、不记依赖地做：不算依赖" (rt join 跑15 "，" 跑15b)))

    (let 次 0)
    (let k (call 新状态 1))
    (let 懒 (call 新派生 (fn ()
      (set 次 (+ 次 1))
      (return (send k 读)))))
    (do (call 报 "16a" "派生值没人读就不算" 次))
    (do (send 懒 读))
    (do (send 懒 读))
    (do (call 报 "16b" "读两次只算一次" 次))
    (do (send k 写 2))
    (do (call 报 "16c" "依赖变了也不马上算" 次))
    (do (call 报 "16d" "再读才算" (rt join (send 懒 读) "，" 次)))

    (let m (call 新状态 1))
    (let 平方 (call 新派生 (-> () (* (send m 读) (send m 读)))))
    (let 记17 (list))
    (let 停17 (call 跟着做 (fn () (do (rt listPush 记17 (send 平方 读))))))
    (do (send m 写 2))
    (do (call 等更新))
    (do (send m 写 (neg 2)))
    (do (call 等更新))
    (do (call 报 "17" "跟着做的事读派生值（已知的粗糙处：派生值没变也重做一次）" 记17))

    (let n (call 新状态 0))
    (let 记18 (list))
    (let 停18a (call 跟着做 (fn ()
      (if (when (== (send n 读) 1) (throw "故意的"))))))
    (let 停18b (call 跟着做 (fn ()
      (do (rt listPush 记18 (rt join "好" (send n 读)))))))
    (do (send n 写 1))
    (do (call 等更新))
    (do (call 报 "18" "一件跟着做的事出错，不影响别的" (rt join 记18 "｜" (rt listGet 错们 (- (rt size 错们) 1)))))

    (@设为 积木计数 5)
    (@一起改 (口
      (@设为 积木计数 6)
      (@设为 积木计数 7)))
    (do (call 等更新))
    (do (call 报 "19a" "用积木外观写的“当…变了”" 积木记录))
    (do (call 报 "19b" "用积木外观读状态" (@状态的值 积木计数)))

    ; ———— 事件总线 ————
    (let 总 (new 事件总线))
    (let 记20 (list))
    (let 退甲 (send 总 订阅 "招呼" (fn (数据) (do (rt listPush 记20 (rt join "甲:" 数据))))))
    (let 退乙 (send 总 订阅 "招呼" (fn (数据) (do (rt listPush 记20 (rt join "乙:" 数据))))))
    (let 个数 (send 总 发出 "招呼" "你好"))
    (do (call 报 "20" "订阅和发出：按订阅的先后叫" (rt join 记20 "，叫到 " 个数 " 个")))
    (let 第一次退 (call 退甲))
    (do (send 总 发出 "招呼" "再见"))
    (do (call 报 "21" "退订以后不叫；再退一次也没事" (rt join 记20 "，" 第一次退 "，" (call 退甲))))

    (let 记22 (list))
    (do (send 总 只听一次 "铃" (fn (数据) (do (rt listPush 记22 数据)))))
    (do (send 总 发出 "铃" 1))
    (let 第二次 (send 总 发出 "铃" 2))
    (do (call 报 "22" "只听一次" (rt join 记22 "，第二次叫到 " 第二次 "，还在听的 " (send 总 有几个在听 "铃"))))

    (let 记23 (list))
    (let 退后面 null)
    (do (send 总 订阅 "改" (fn (数据)
      (do (rt listPush 记23 "一"))
      (do (call 退后面)))))
    (set 退后面 (send 总 订阅 "改" (fn (数据) (do (rt listPush 记23 "二")))))
    (do (send 总 订阅 "改" (fn (数据) (do (rt listPush 记23 "三")))))
    (let 叫23 (send 总 发出 "改"))
    (do (call 报 "23" "发出过程中把排在后面的退订了：它不被叫" (rt join 记23 "，叫到 " 叫23)))

    (let 记24 (list))
    (do (send 总 订阅 "加" (fn (数据)
      (do (rt listPush 记24 "老"))
      (do (send 总 订阅 "加" (fn (数据2) (do (rt listPush 记24 "新"))))))))
    (do (send 总 发出 "加"))
    (do (send 总 发出 "加"))
    (do (call 报 "24" "发出过程中新订阅的：这一次不叫，下一次才叫" 记24))

    (let 记25 (list))
    (let 错25 (list))
    (do (send 总 设出错时 (fn (消息 事件名) (do (rt listPush 错25 (rt join 事件名 ":" 消息))))))
    (do (send 总 订阅 "炸" (fn (数据) (throw "坏了"))))
    (do (send 总 订阅 "炸" (fn (数据) (do (rt listPush 记25 "还是叫到了")))))
    (do (send 总 订阅 "炸" (fn () (do (rt listPush 记25 "不该到这里")))))
    (let 叫25 (send 总 发出 "炸" 0))
    (do (call 报 "25" "一个处理出错（或者参数个数不对）不影响别的" (rt join 记25 "｜" 错25 "｜" 叫25)))

    (do (call 报 "26" "没人听的事件" (send 总 发出 "没人听")))

    (let 另一条 (new 事件总线))
    (let 记27 (list))
    (do (send 另一条 订阅 "招呼" (fn (数据) (do (rt listPush 记27 数据)))))
    (do (send 总 发出 "招呼" "只给第一条"))
    (do (call 报 "27" "两条总线互不相干" (rt join (rt size 记27) "，" (send 另一条 发出 "招呼" "给第二条") "，" 记27)))

    (let 计 (call 新状态 0))
    (let 跑28 0)
    (let 停28 (call 跟着做 (fn ()
      (do (send 计 读))
      (set 跑28 (+ 跑28 1)))))
    (do (send 总 订阅 "加一" (fn (数据) (do (send 计 写 (+ (send 计 偷看) 数据))))))
    (do (send 总 发出 "加一" 1))
    (do (send 总 发出 "加一" 1))
    (do (send 总 发出 "加一" 1))
    (do (call 等更新))
    (do (call 报 "28" "事件处理里改状态：三次改动，跟着做的只多跑一次" (rt join (send 计 偷看) "，" 跑28)))

    (let 记29 (list))
    (do (send 总 订阅 "外" (fn (数据)
      (do (rt listPush 记29 "外1"))
      (do (send 总 发出 "内"))
      (do (rt listPush 记29 "外1完")))))
    (do (send 总 订阅 "外" (fn (数据) (do (rt listPush 记29 "外2")))))
    (do (send 总 订阅 "内" (fn (数据) (do (rt listPush 记29 "内")))))
    (do (send 总 发出 "外"))
    (do (call 报 "29" "处理里再发出：里面的先做完" 记29))

    (@发出事件 全局总线 "积木事件" "来了")
    (@发出事件 全局总线 "积木事件" _)
    (do (call 报 "30" "用积木外观写的订阅和发出" 积木收到的))))
