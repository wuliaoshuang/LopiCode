; p08 类、继承、接口。字段和“创建时”的参数标了类型；方法的返回值、主程序里的变量都没标。
(接口 有面积 (面积 () 小数) (名字 () 文字))
(类 圆 (实现 有面积)
  (字段 r 小数)
  (创建 ((r 小数)) (改字段 (这) r r))
  (方法 面积 () (返回 (* 3 (* (. (这) r) (. (这) r)))))
  (方法 名字 () (返回 "圆")))
(类 方 (实现 有面积)
  (字段 a 小数)
  (创建 ((a 小数)) (改字段 (这) a a))
  (方法 面积 () (返回 (* (. (这) a) (. (这) a))))
  (方法 名字 () (返回 "方")))
(类 动物 可继承
  (字段 名 文字)
  (字段 腿 整数 4)
  (创建 ((名 文字)) (改字段 (这) 名 名))
  (方法 叫声 () (返回 "…"))
  (方法 介绍 () (返回 (连 (. (这) 名) "说" (发 (这) 叫声) "，" (. (这) 腿) "条腿"))))
(类 狗 (继承 动物)
  (创建 ((名 文字)) (父创建 名))
  (方法 叫声 () (返回 "汪")))
(类 鸟 (继承 动物) 可继承
  (创建 ((名 文字)) (父创建 名) (改字段 (这) 腿 2))
  (方法 叫声 () (返回 (连 "啾" (父 叫声)))))
(函数 总面积 ((xs (列表 有面积)))
  (返回 (调 归并 xs 0 (λ (s x) (+ s (发 x 面积))))))
(主
  (设 形 (列 (新 圆 1) (新 方 2)))
  (每个 s 形 (打印 (连 (发 s 名字) " " (发 s 面积))))
  (打印 (连 "总面积 " (调 总面积 形)))
  (设 宠 (列 (新 狗 "旺财") (新 鸟 "啾啾") (新 动物 "某只")))
  (每个 p 宠 (打印 (发 p 介绍)))
  (设 d (项 宠 0))
  (如果 (是 狗 d) (那么 (打印 "第一只是狗")))
  (打印 (连 "是鸟吗 " (是 鸟 d))))
