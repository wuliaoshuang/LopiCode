; p01 整数与小数：混算、除法、整除、取余、溢出、除以 0。全篇没有标任何类型。
(主
  (设 a 7) (设 b 2)
  (设 x 0.1) (设 y 0.2)
  (打印 (连 "7/2=" (/ a b)))
  (打印 (连 "7整除2=" (整除 a b)))
  (打印 (连 "-7整除2=" (整除 (- 0 a) b)))
  (打印 (连 "-7余2=" (余 (- 0 a) b)))
  (打印 (连 "7余-2=" (余 a (- 0 b))))
  (打印 (连 "0.1+0.2=" (+ x y)))
  (打印 (连 "a+x=" (+ a x)))
  (打印 (连 "6/3=" (/ 6 3)))
  (设 大 9007199254740991)
  (打印 (连 "最大整数=" 大))
  (设 平均 (/ (+ a b) 2))
  (打印 (连 "平均=" 平均))
  (设 n (取整 (* x 30)))
  (打印 (连 "n=" n))
  (设 f 1e308)
  (打印 (连 "太大=" (* f 10)))
  (试 (做 (打印 (连 "大+1=" (+ 大 1)))) (出错 e (打印 (连 "接住：" e))))
  (试 (做 (打印 (连 "7整除0=" (整除 a 0)))) (出错 e (打印 (连 "接住：" e))))
  (试 (做 (打印 (连 "x/0=" (/ x 0)))) (出错 e (打印 (连 "接住：" e))))
  (打印 (连 "平方=" (* 94906267 94906267))))
