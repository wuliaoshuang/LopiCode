; p16（第二轮新加）确定类型的列表 / 字典和“任意”之间怎么过：
;   装进任意 ＝ 拍一份快照；从任意取回成 列表〈整数〉 ＝ 逐项检查、得到一份新的；
;   当成 列表〈任意〉 ＝ 只看“是不是列表”，还是同一个。
; 标了类型的：装、装2（任意）。其余没标。
(主
  (设 xs (列 1 2 3))
  (设 装 任意 xs)
  (加项 xs 4)
  (打印 (连 "原来的有 " (长 xs) " 项，装进任意的是 " 装))
  (设 动 (转 (列表 任意) 装))
  (加项 动 "五")
  (打印 (连 "任意里的 " 装))
  (试 (做 (做 (转 (列表 整数) 装)) (打印 "到不了这里")) (出错 e (打印 (连 "不行：" e))))
  (删末项 动)
  (设 回 (转 (列表 整数) 装))
  (加项 回 9)
  (打印 (连 "取回来的 " (拼 (调 映射 回 (λ (n) (文 n))) ",") "，任意里的 " 装 "，原来的有 " (长 xs) " 项"))
  (设 d (典 ("a" 1.5)))
  (设 装2 任意 d)
  (存 d "b" 2)
  (打印 (连 "字典 " 装2 "，原来的有 " (长 d) " 项")))
