; p10 “任意”和确定类型的边界：任意 → 确定类型要过一次检查（转），不对就抛错；确定类型 → 任意随便放。
; 标了类型的：读用户 的参数（任意）和返回值，主程序里的 好、n、装、坏。
(函数 读用户 ((数据 任意)) -> 文字
  (设 d (转 (字典 任意) 数据))
  (设 名 (转 文字 (取 d "名字")))
  (设 岁 (转 整数 (取 d "年龄")))
  (设 标签 (调 映射 (转 (列表 任意) (取 d "标签")) (λ (t) (转 文字 t))))
  (返回 (连 名 " " (+ 岁 1) " " (拼 标签 "/"))))
(主
  (设 好 任意 (典 ("名字" "小明") ("年龄" 12) ("标签" (列 "a" "b"))))
  (打印 (调 读用户 好))
  (设 n 整数 41)
  (设 装 任意 n)
  (打印 (连 "装进再取出 " (+ (转 整数 装) 1)))
  (打印 (连 "任意相加 " (+ 装 0.5)))
  (打印 (连 "任意的样子 " 好))
  (每个 坏 (标 (列表 任意) (列
      (典 ("名字" "小红") ("年龄" "十二") ("标签" (列)))
      (典 ("名字" 7))
      (典 ("名字" "小刚") ("年龄" 12.5) ("标签" (列)))
      "不是字典"
      (典 ("名字" "小白") ("年龄" 3) ("标签" (列 1)))))
    (试 (做 (打印 (调 读用户 坏))) (出错 e (打印 (连 "不行：" e))))))
