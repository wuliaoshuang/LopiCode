; p13 一个类型都不标。看“不标类型的人照样能用”：自己文件里的函数，参数类型从所有调用它的地方反推。
(函数 平均 (xs)
  (设 总 0)
  (每个 x xs (改 总 (+ 总 x)))
  (返回 (/ 总 (长 xs))))
(函数 重复 (s n)
  (设 out "")
  (数 i 0 n (改 out (连 out s)))
  (返回 out))
(函数 较大 (a b)
  (如果 (> a b) (那么 (返回 a)))
  (返回 b))
(函数 阶乘 (n)
  (如果 (<= n 1) (那么 (返回 1)))
  (返回 (* n (调 阶乘 (- n 1)))))
(函数 随便 (v)
  (返回 (连 "[" v "]")))
(主
  (打印 (连 "平均 " (调 平均 (列 1 2 4))))
  (打印 (调 重复 "ab" 3))
  (打印 (连 "较大 " (调 较大 3 7)))
  (打印 (连 "较大 " (调 较大 2.5 1)))
  (打印 (连 "阶乘 " (调 阶乘 10)))
  (打印 (调 随便 1))
  (打印 (调 随便 "x"))
  (打印 (调 随便 (列 1 2)))
  (打印 (连 "阶乘 " (调 阶乘 19))))
