; p15 对拍：用同一个伪随机数列（x = x*48271 余 2147483647）造 2000 组数，做整数的加减乘、整除、余，小数的加减乘除，
; 把所有结果按“数字的写法”拼起来算一个校验和。四种语言的校验和必须一样——
; 这是在验证“整数/小数的运算规矩和数字的写法，在四种语言里对每一组输入都一样”，不只是手挑的几个例子。
; 另外同一组数再走一遍“任意”的路（小库的 dadd 等），两条路的结果必须相同（“开不开类型优化结果一样”）。
(函数 下一个 ((x 整数)) -> 整数 (返回 (余 (* x 48271) 2147483647)))
(函数 搅 ((h 整数) (s 文字)) -> 整数
  (每个 c (码点们 s) (改 h (余 (+ (* h 31) c) 1000000007)))
  (返回 h))
(主
  (设 x 20261125) (设 h1 7) (设 h2 7) (设 错 0) (设 不同 0)
  (数 i 0 2000
    (改 x (调 下一个 x)) (设 a (- (余 x 2000001) 1000000))
    (改 x (调 下一个 x)) (设 b (- (余 x 41) 20))
    (改 x (调 下一个 x)) (设 p (/ (- (余 x 2000001) 1000000) 997))
    (改 x (调 下一个 x)) (设 q (/ (- (余 x 20001) 10000) 7))
    (设 r1 (试算 (连 (+ a b) "," (- a b) "," (* a b) "," (整除 a b) "," (余 a b) "," (/ a b) "," (+ p q) "," (- p q) "," (* p q) "," (/ p q))))
    (设 r2 (试算 (连 (任+ a b) "," (任- a b) "," (任* a b) "," (任整除 a b) "," (任余 a b) "," (任/ a b) "," (任+ p q) "," (任- p q) "," (任* p q) "," (任/ p q))))
    (如果 (== r1 "除以 0") (那么 (改 错 (+ 错 1))))
    (如果 (!= r1 r2) (那么 (改 不同 (+ 不同 1))))
    (改 h1 (调 搅 h1 r1)) (改 h2 (调 搅 h2 r2)))
  (打印 (连 "校验和（原生类型的路）" h1))
  (打印 (连 "校验和（任意的路）" h2))
  (打印 (连 "除以 0 的次数 " 错 "，两条路不同的次数 " 不同)))
