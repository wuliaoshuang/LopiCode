; p14 泛型类：库作者要用的两样东西——栈〈T〉和“状态容器〈T〉”（值一变就通知订阅的人）。
; 类的定义标全了；用的人只在“新 栈〈整数〉”这一处写了类型（空的栈没有别的线索），状态容器那里一个字没标。
(类 栈 (泛型 T)
  (字段 项 (列表 T) (列))
  (创建 ())
  (方法 压 ((x T)) (加项 (. (这) 项) x))
  (方法 弹 () -> (可空 T)
    (如果 (== (长 (. (这) 项)) 0) (那么 (返回 空)))
    (设 x (项 (. (这) 项) (- (长 (. (这) 项)) 1)))
    (删末项 (. (这) 项))
    (返回 x))
  (方法 大小 () -> 整数 (返回 (长 (. (这) 项)))))
(类 状态 (泛型 T)
  (字段 值 T)
  (字段 听 (列表 (函数 (T T) 空)) (列))
  (创建 ((初 T)) (改字段 (这) 值 初))
  (方法 读 () -> T (返回 (. (这) 值)))
  (方法 订阅 ((f (函数 (T T) 空))) (加项 (. (这) 听) f))
  (方法 写 ((新值 T))
    (设 旧 (. (这) 值))
    (改字段 (这) 值 新值)
    (每个 f (. (这) 听) (做 (调 f 旧 新值)))))
(主
  (设 s (新 (栈 整数)))
  (发 s 压 1) (发 s 压 2) (发 s 压 3)
  (打印 (连 "弹 " (或空 (发 s 弹) -1) " 剩 " (发 s 大小)))
  (设 名 (新 栈))
  (发 名 压 "a")
  (打印 (连 "弹 " (或空 (发 名 弹) "?") " 再弹 " (或空 (发 名 弹) "空了")))
  (设 计数 (新 状态 0))
  (设 记 (列))
  (发 计数 订阅 (λ块 (旧 新值) (加项 记 (连 旧 "→" 新值))))
  (发 计数 写 (+ (发 计数 读) 1))
  (发 计数 写 (* (发 计数 读) 10))
  (打印 (拼 记 " "))
  (设 标题 (新 状态 "你好"))
  (发 标题 订阅 (λ块 (旧 新值) (打印 (连 "标题变了：" 新值))))
  (发 标题 写 "再见"))
