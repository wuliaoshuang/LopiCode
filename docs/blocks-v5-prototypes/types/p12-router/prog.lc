; p12 综合：一个“小路由”。路由表、路径参数、中间件（函数包函数）、404。
; 标了类型的：记录和类的字段、方法的参数、类型别名 处理。匿名函数的参数、方法 加/用 的返回值、主程序里的变量都没标。
(枚举 方法 GET POST)
(记录 请求 (方法 方法) (路径 文字) (内容 文字))
(记录 响应 (状态 整数) (内容 文字))
(别名 处理 (函数 (请求 (字典 文字)) 响应))
(记录 路由 (方法 方法) (段 (列表 文字)) (处理 处理))
(类 路由器
  (字段 表 (列表 路由) (列))
  (字段 中间件 (列表 (函数 (处理) 处理)) (列))
  (创建 ())
  (方法 加 ((m 方法) (路径 文字) (h 处理))
    (加项 (. (这) 表) (新记 路由 (方法 m) (段 (切 路径 "/")) (处理 h))))
  (方法 用 ((mw (函数 (处理) 处理)))
    (加项 (. (这) 中间件) mw))
  (方法 匹配 ((模 (列表 文字)) (实 (列表 文字))) -> (可空 (字典 文字))
    (如果 (!= (长 模) (长 实)) (那么 (返回 空)))
    (设 参 (字典 文字) (典))
    (数 i 0 (长 模)
      (设 a (项 模 i))
      (设 b (项 实 i))
      (如果 (开头是 a ":")
        (那么 (存 参 (截 a 1 (文长 a)) b))
        (否则 (如果 (!= a b) (那么 (返回 空))))))
    (返回 参))
  (方法 处理 ((req 请求)) -> 响应
    (设 实 (切 (. req 路径) "/"))
    (每个 r (. (这) 表)
      (如果 (== (. r 方法) (. req 方法)) (那么
        (设 参 (发 (这) 匹配 (. r 段) 实))
        (如果 (非空 参) (那么
          (设 h (. r 处理))
          (每个 mw (. (这) 中间件) (改 h (调 mw h)))
          (返回 (调 h req 参)))))))
    (返回 (新记 响应 (状态 404) (内容 (连 "没有这个地址：" (. req 路径)))))))
(主
  (设 app (新 路由器))
  (设 次数 0)
  (发 app 用 (λ (下一个) (λ块 (req 参) (改 次数 (+ 次数 1)) (返回 (调 下一个 req 参)))))
  (发 app 用 (λ (下一个) (λ块 (req 参)
    (设 res (调 下一个 req 参))
    (返回 (改记 res (内容 (连 (. res 内容) " ✓")))))))
  (发 app 加 (枚 方法 GET) "/hello/:name"
    (λ (req 参) (新记 响应 (状态 200) (内容 (连 "你好，" (或空 (取 参 "name") "?"))))))
  (发 app 加 (枚 方法 POST) "/sum/:a/:b" (λ块 (req 参)
    (设 a (解析整数 (或空 (取 参 "a") "")))
    (设 b (解析整数 (或空 (取 参 "b") "")))
    (如果 (或 (是空 a) (是空 b)) (那么 (返回 (新记 响应 (状态 400) (内容 "要两个整数")))))
    (返回 (新记 响应 (状态 200) (内容 (连 (+ a b) " " (. req 内容)))))))
  (每个 q (列
      (新记 请求 (方法 (枚 方法 GET)) (路径 "/hello/小明") (内容 ""))
      (新记 请求 (方法 (枚 方法 POST)) (路径 "/sum/3/4") (内容 "ok"))
      (新记 请求 (方法 (枚 方法 POST)) (路径 "/sum/3/x") (内容 ""))
      (新记 请求 (方法 (枚 方法 GET)) (路径 "/nope") (内容 ""))
      (新记 请求 (方法 (枚 方法 GET)) (路径 "/sum/1/2") (内容 "")))
    (设 res (发 app 处理 q))
    (打印 (连 (. res 状态) " " (. res 内容))))
  (打印 (连 "经过中间件 " 次数 " 次")))
