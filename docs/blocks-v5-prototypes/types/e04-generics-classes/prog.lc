; e04 故意写错：泛型的约束、接口没实现全、列表里放错东西、空列表看不出放什么、匿名函数参数个数不对。
(接口 会叫 (叫 () 文字))
(类 猫 (实现 会叫)                                    ; 错 1：说自己“会叫”，却没有“叫”这个方法
  (字段 名 文字)
  (创建 ((名 文字)) (改字段 (这) 名 名)))
(记录 点位 (x 小数) (y 小数))
(函数 最大 (泛型 (T 能比较)) ((xs (列表 T)) (底 T)) -> T
  (设 m 底)
  (每个 x xs (如果 (> x m) (那么 (改 m x))))
  (返回 m))
(函数 头 (泛型 T) ((xs (列表 T)) (底 T)) -> T
  (如果 (> (长 xs) 0) (那么
    (如果 (> (项 xs 0) 底) (那么 (返回 (项 xs 0))))))  ; 错 2：T 没说“能比大小”就拿来比
  (返回 底))
(主
  (设 ps (列 (新记 点位 (x 1) (y 2))))
  (打印 (. (调 最大 ps (新记 点位 (x 0) (y 0))) x))    ; 错 3：点位不能比大小
  (设 ns (列 1 2 3))
  (加项 ns "四")                                       ; 错 4：整数的列表里加文字
  (设 空的 (列))                                       ; 提醒：从头到尾看不出里面放什么
  (打印 (长 空的))
  (打印 (拼 (调 映射 ns (λ (a b) (文 a))) ",")))       ; 错 5：映射要收 1 个参数的函数
