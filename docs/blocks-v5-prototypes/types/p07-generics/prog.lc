; p07 泛型函数：类型实参全靠调用处推断，用的人从来不用写〈…〉。三个函数的签名都标全了（泛型函数必须标）。
(函数 第一个 (泛型 T) ((xs (列表 T))) -> (可空 T)
  (如果 (== (长 xs) 0) (那么 (返回 空)))
  (返回 (项 xs 0)))
(函数 最大 (泛型 (T 能比较)) ((xs (列表 T)) (底 T)) -> T
  (设 m 底)
  (每个 x xs (如果 (> x m) (那么 (改 m x))))
  (返回 m))
(函数 配对 (泛型 K V) ((ks (列表 K)) (vs (列表 V)) (f (函数 (K V) 文字))) -> (列表 文字)
  (设 out (列表 文字) (列))
  (数 i 0 (长 ks) (加项 out (调 f (项 ks i) (项 vs i))))
  (返回 out))
(主
  (打印 (连 "第一个 " (或空 (调 第一个 (列 3 1 2)) -1)))
  (设 空表 (列表 文字) (列))
  (打印 (连 "空的第一个 " (或空 (调 第一个 空表) "没有")))
  (打印 (连 "最大整数 " (调 最大 (列 3 9 2) 0)))
  (打印 (连 "最大小数 " (调 最大 (列 1.5 0.25) 0)))
  (打印 (连 "最大文字 " (调 最大 (列 "ｚ" "😀" "a") "")))
  (打印 (拼 (调 配对 (列 "a" "b") (列 1 2) (λ (k v) (连 k "=" v))) ";")))
