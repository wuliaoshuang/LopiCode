; p02 可空与“判断过就收窄”。标了类型的：找年龄 的参数和返回值、描述 的参数、变量 首字。其余没标。
(函数 找年龄 ((名单 (字典 整数)) (名字 文字)) -> (可空 整数)
  (返回 (取 名单 名字)))
(函数 描述 ((岁 (可空 整数)))
  (如果 (是空 岁) (那么 (返回 "不知道")))
  (如果 (>= 岁 18) (那么 (返回 (连 岁 "岁，成年"))))
  (返回 (连 岁 "岁，未成年")))
(主
  (设 名单 (典 ("小明" 12) ("小红" 20)))
  (打印 (调 描述 (调 找年龄 名单 "小明")))
  (打印 (调 描述 (调 找年龄 名单 "小红")))
  (打印 (调 描述 (调 找年龄 名单 "小刚")))
  (设 岁 (取 名单 "小刚"))
  (打印 (连 "默认：" (或空 岁 0)))
  (设 总 0)
  (每个 名 (列 "小明" "小红" "小刚")
    (设 v (取 名单 名))
    (如果 (非空 v) (那么 (改 总 (+ 总 v)))))
  (打印 (连 "总和：" 总))
  (设 首字 (可空 文字) 空)
  (如果 (且 (非空 岁) (> 岁 3)) (那么 (改 首字 "大")) (否则 (改 首字 "无")))
  (打印 (连 "首字：" (或空 首字 "?")))
  (打印 (连 "硬取：" (必有 岁))))
