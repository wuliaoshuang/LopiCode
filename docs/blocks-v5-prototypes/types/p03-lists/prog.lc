; p03 列表〈T〉与高阶函数：映射 / 筛选 / 归并 的泛型推断。全篇没有标任何类型（匿名函数的参数也没标）。
(主
  (设 数 (列 1 2 3 4 5 6))
  (设 平方 (调 映射 数 (λ (n) (* n n))))
  (设 偶 (调 筛选 平方 (λ (n) (== (余 n 2) 0))))
  (设 和 (调 归并 偶 0 (λ (acc n) (+ acc n))))
  (设 半 (调 映射 数 (λ (n) (/ n 2))))
  (设 均 (调 归并 半 0 (λ (acc h) (+ acc h))))
  (设 词 (调 映射 数 (λ (n) (连 "#" n))))
  (设 空的 (列))
  (加项 空的 2.5)
  (加项 空的 1)
  (打印 (连 "平方 " (拼 (调 映射 平方 (λ (n) (文 n))) ",")))
  (打印 (连 "偶 " (拼 (调 映射 偶 (λ (n) (文 n))) ",")))
  (打印 (连 "和 " 和))
  (打印 (连 "半 " (拼 (调 映射 半 (λ (h) (文 h))) ",")))
  (打印 (连 "均 " 均))
  (打印 (连 "词 " (拼 词 ",")))
  (打印 (连 "空的 " (拼 (调 映射 空的 (λ (h) (文 h))) ",") " 长 " (长 空的)))
  (打印 (连 "第7项 " (项 数 6))))
