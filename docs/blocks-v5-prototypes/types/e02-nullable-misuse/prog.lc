; e02 故意写错：可能是空的值，没判断就用。也放了几处写对的，确认不会乱报。
(记录 用户 (名字 文字) (年龄 (可空 整数)))
(函数 明年 ((u 用户)) -> 整数
  (返回 (+ (. u 年龄) 1)))                     ; 错 1：字段可能是空就拿来算
(函数 找 ((d (字典 整数)) (k 文字)) -> 整数
  (返回 (取 d k)))                             ; 错 2：从字典里取出来的可能是空，却说好返回整数
(函数 加倍 ((n 整数)) -> 整数 (返回 (* n 2)))
(主
  (设 d (典 ("a" 1)))
  (设 v (取 d "a"))
  (打印 (调 加倍 v))                           ; 错 3：可能是空的值放进要整数的参数
  (如果 (非空 v) (那么 (打印 (调 加倍 v))))    ; 对：判断过了
  (如果 (非空 v) (那么
    (改 v (取 d "b"))
    (打印 (> v 0))))                           ; 错 4：判断过以后又被改成可能是空的值
  (设 w (取 d "a"))
  (如果 (非空 w) (那么
    (设 f (λ () (* w 3)))                      ; 对：w 从没被改过，判断结果可以带进匿名函数
    (设 g (λ () (* v 3)))                      ; 错 5：v 在别处被改过，带不进去
    (打印 (连 (调 f) (调 g)))))
  (打印 (或空 v 0)))                           ; 对：给了“是空就用 0”
