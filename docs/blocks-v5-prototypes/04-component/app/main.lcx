; 04 的检查程序（第 2 轮）：把组件“待办列表”放到假的页面上，点、改、删、调顺序、清空、拿走，每一步打印一行。
; 期望的输出是先手写好的（../expected.txt）。
(module 检查
  (uses 状态库 画面库 待办组件库)
  (native test.tree (从哪 带号))
  (native test.find (范围 选择 第几个))
  (native test.click (控件))
  (native test.ops ())

  (func 报 (号 名字 值)
    (do (rt log (rt join "[" 号 "] " 名字 "：" 值))))

  (func 做了 ()
    (let o (native test.ops))
    (return (rt join "新建 " (rt dictGet o "新建") "，写 " (rt dictGet o "写") "，插入 " (rt dictGet o "插入") "，拿走 " (rt dictGet o "拿走"))))

  (func 树 (容器)
    (return (native test.tree (native test.find 容器 "ul" 1) false)))

  (func 行 (容器 第几)
    (return (native test.find 容器 "li.item" 第几)))

  (func 去掉 (列 号)
    (let 出 (list))
    (for-each 条 列 (if (when (!= (rt dictGet 条 "号") 号) (do (rt listPush 出 条)))))
    (return 出))

  (func 加上 (列 条)
    (let 出 (list))
    (for-each 老 列 (do (rt listPush 出 老)))
    (do (rt listPush 出 条))
    (return 出))

  (var 积木条目 (@新状态 (list (dict ("号" 1) ("标题" "积木放的") ("完成" false)))))
  (var 积木收到 (list))

  (main
    (let 记 (list))
    (let 第二条 (dict ("号" 2) ("标题" "写作业") ("完成" true)))
    (let 条目们 (call 新状态 (list (dict ("号" 1) ("标题" "买菜") ("完成" false)) 第二条)))
    (let 容器甲 (call 元素 "div" (dict ("类名" "a"))))
    (do (call 放进 (call 页面根) 容器甲 null))
    (let 拿走甲 (call 挂上 容器甲 (fn ()
      (return (call 待办列表
        (dict ("条目们" (fn () (return (send 条目们 读)))))
        (dict
          ("点了" (fn (条) (do (rt listPush 记 (rt join "点了:" (rt dictGet 条 "标题"))))))
          ("删了" (fn (条)
            (do (rt listPush 记 (rt join "删了:" (rt dictGet 条 "标题"))))
            (do (send 条目们 写 (call 去掉 (send 条目们 偷看) (rt dictGet 条 "号"))))))))))))
    (do (call 等更新))
    (do (call 报 "1" "画出来的树" (call 树 容器甲)))
    (let 元1 (call 行 容器甲 1))
    (let 元2 (call 行 容器甲 2))

    (do (call 做了))
    (do (native test.click 元2))
    (do (call 报 "2" "点第 2 条，收到的事件" 记))
    (do (call 报 "3" "点了以后的树（第 2 条多了“选中”）" (call 树 容器甲)))
    (do (call 报 "4" "这一下宿主只被要求做了" (call 做了)))

    (do (send 条目们 写 (list (dict ("号" 1) ("标题" "买菜") ("完成" true)) 第二条)))
    (do (call 等更新))
    (do (call 报 "5" "把第 1 条标成完成以后的树" (call 树 容器甲)))
    (do (call 报 "6" "这一下宿主只被要求做了" (call 做了)))

    (do (send 条目们 写 (call 加上 (send 条目们 偷看) (dict ("号" 3) ("标题" "复习") ("完成" false)))))
    (do (call 等更新))
    (do (call 报 "7" "末尾加一条以后的树" (call 树 容器甲)))
    (do (call 报 "8" "原来两条还是原来那两个元素" (rt join (rt isSame 元1 (call 行 容器甲 1)) "，" (rt isSame 元2 (call 行 容器甲 2)))))

    (do (send 条目们 写 (call 加上 (send 条目们 偷看) (dict ("号" 4) ("标题" "交报告") ("完成" false)))))
    (do (call 等更新))
    (do (call 报 "9" "再加第四条以后的树" (call 树 容器甲)))
    (let 元3 (call 行 容器甲 3))
    (let 元4 (call 行 容器甲 4))

    (do (call 做了))
    (do (native test.click (native test.find 容器甲 "button.del" 1)))
    (do (call 报 "10" "点第 1 条的“删”，收到的事件（没有多出“点了:买菜”）" 记))
    (do (call 报 "11" "删了以后的树" (call 树 容器甲)))
    (do (call 报 "12" "这一下宿主只被要求做了" (call 做了)))
    (do (call 报 "13" "剩下三条还是原来的元素" (rt join (rt isSame 元2 (call 行 容器甲 1)) "，" (rt isSame 元3 (call 行 容器甲 2)) "，" (rt isSame 元4 (call 行 容器甲 3)))))

    (let 现在的 (send 条目们 偷看))
    (do (send 条目们 写 (list (rt listGet 现在的 2) (rt listGet 现在的 1) (rt listGet 现在的 0))))
    (do (call 等更新))
    (do (call 报 "14" "把顺序倒过来以后的树" (call 树 容器甲)))
    (let o (native test.ops))
    (do (call 报 "15" "调顺序没有新建也没有拿走，元素还是原来的" (rt join "新建 " (rt dictGet o "新建") "，拿走 " (rt dictGet o "拿走") "，"
      (rt isSame 元4 (call 行 容器甲 1)) "，" (rt isSame 元3 (call 行 容器甲 2)) "，" (rt isSame 元2 (call 行 容器甲 3)))))

    (do (send 条目们 写 (list)))
    (do (call 等更新))
    (do (call 报 "16" "清空以后（默认的“空的时候”）" (call 树 容器甲)))
    (do (send 条目们 写 (list (dict ("号" 5) ("标题" "新的一条") ("完成" false)))))
    (do (call 等更新))
    (do (call 报 "17" "再加一条，空提示没了" (call 树 容器甲)))

    ; ———— 第二个实例：自己给插槽 ————
    (let 条目乙 (call 新状态 (list)))
    (let 生命 (list))
    (let 容器乙 (call 元素 "div" (dict ("类名" "b"))))
    (do (call 放进 (call 页面根) 容器乙 null))
    (let 拿走乙 (call 挂上 容器乙 (fn ()
      (do (call 放上以后 (fn () (do (rt listPush 生命 "放上以后")))))
      (do (call 拿走之前 (fn () (do (rt listPush 生命 "拿走之前")))))
      (return (call 待办列表
        (dict ("条目们" (fn () (return (send 条目乙 读)))))
        (dict ("点了" (fn (条) (do (rt listPush 记 (rt join "乙点了:" (rt dictGet 条 "标题")))))))
        (dict
          ("每一条" (fn (条目)
            (return (call 元素 "div" (dict ("类名" "row")) (list
              (call 元素 "span" (dict ("类名" "pri") ("文字" (fn () (return (rt dictGet (call! 条目) "级"))))))
              (call 元素 "span" (dict ("类名" "name") ("文字" (fn () (return (rt dictGet (call! 条目) "标题")))))))))))
          ("空的时候" (fn ()
            (return (call 元素 "p" (dict ("类名" "none") ("文字" "空空如也"))))))))))))
    (do (call 等更新))
    (do (call 报 "18" "第二个待办列表（自己给了两个插槽），空的时候" (call 树 容器乙)))
    (do (send 条目乙 写 (list (dict ("号" 1) ("标题" "交报告") ("级" "高")))))
    (do (call 等更新))
    (do (call 报 "19" "第二个列表有了一条（“每一条怎么画”是自己给的）" (call 树 容器乙)))
    (let 乙的元素 (call 行 容器乙 1))
    (do (native test.click 乙的元素))
    (do (call 报 "20" "点第二个列表的第 1 条" (rt join "第二个：" (call 树 容器乙) "｜第一个没变：" (call 树 容器甲))))
    (do (call 报 "21" "第二个列表的“放上以后”叫过" 生命))
    (do (call! 拿走乙))
    (do (call 等更新))
    (do (call 报 "22" "拿走第二个列表" (rt join "容器里：" (native test.tree 容器乙 false) "｜" 生命)))
    (do (call 做了))
    (do (send 条目乙 写 (list)))
    (do (call 等更新))
    (do (native test.click 乙的元素))
    (do (call 报 "23" "拿走以后改它的条目、点它原来的元素" (rt join "宿主什么都没被要求做：" (call 做了) "｜事件一共还是 " (rt size 记) " 个")))

    ; ———— 用积木外观放 ————
    (let 容器丙 (call 元素 "div" (dict ("类名" "c"))))
    (do (call 放进 (call 页面根) 容器丙 null))
    (@放一个待办列表 容器丙 (@状态的值 积木条目)
      (口 (do (rt listPush 积木收到 (rt dictGet 条目 "标题"))))
      _)
    (do (call 等更新))
    (do (call 报 "24" "用积木外观放一个待办列表" (call 树 容器丙)))
    (do (native test.click (call 行 容器丙 1)))
    (do (call 报 "25" "积木外观的“当点了”口收到" 积木收到))))
