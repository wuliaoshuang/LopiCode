; 库“小框架”·仓库：一类东西的增删改查，数据放在宿主的 store 格子里。
; 第 1 轮：只有 store.get / store.set。每次都是“整份取出来 → 改 → 整份放回去”。
(module 仓库
  (native store.get (名字))
  (native store.set (名字 值))

  (public (class 仓库
    (field 名字 "")
    (ctor (名字)
      (set (. (this) 名字) 名字))

    (method 读 ()
      (let 库 (native store.get (rt join "仓库:" (. (this) 名字))))
      (if (when (rt isNull 库) (return (dict ("next" 1) ("rows" (list))))))
      (return 库))
    (method 写 (库)
      (do (native store.set (rt join "仓库:" (. (this) 名字)) 库)))

    (method 全部 ()
      (return (rt dictGet (send (this) 读) "rows")))
    (method 取 (id)
      (return (rt listFind (send (this) 全部) (-> (行) (== (rt dictGet 行 "id") id)))))
    (method 加 (内容)
      (let 库 (send (this) 读))
      (let 行 (rt dictMerge 内容 (dict ("id" (rt dictGet 库 "next")))))
      (set (index 库 "next") (+ (rt dictGet 库 "next") 1))
      (do (rt listPush (rt dictGet 库 "rows") 行))
      (do (send (this) 写 库))
      (return 行))
    (method 改 (id 内容)
      (let 库 (send (this) 读))
      (let 结果 null)
      (for-each (行 i) (rt dictGet 库 "rows")
        (if (when (== (rt dictGet 行 "id") id)
              (set 结果 (rt dictMerge (rt dictMerge 行 内容) (dict ("id" id))))
              (do (rt listSet (rt dictGet 库 "rows") i 结果)))))
      (if (when (not (rt isNull 结果)) (do (send (this) 写 库))))
      (return 结果))
    (method 删 (id)
      (let 库 (send (this) 读))
      (let 剩下 (rt listFilter (rt dictGet 库 "rows") (-> (行) (!= (rt dictGet 行 "id") id))))
      (if (when (== (rt size 剩下) (rt size (rt dictGet 库 "rows"))) (return false)))
      (set (index 库 "rows") 剩下)
      (do (send (this) 写 库))
      (return true)))))
