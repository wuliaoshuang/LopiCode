; ———— 模块 书店服务 展开积木以后 ————
(native time.sleep (毫秒))
(native time.ms ())
(native log.error (值))
(var app (new 应用))
(var 书们 (new 仓库 "books"))
(var 作者们 (new 仓库 "authors"))
(var 请求数 0)
(class 不许 (extends HTTP错误) (field 需要 "") (ctor (需要) (super-init 403 "这件事只有管理员能做") (set (. (this) 需要) 需要)) (method 变成内容 () (let 内容 (super 变成内容)) (set (index 内容 "need") (. (this) 需要)) (return 内容)))
(class 茶壶 (extends HTTP错误) (ctor () (super-init 418 "我是茶壶")) (method 变成内容 () (return (rt dictMerge (super 变成内容) (dict ("tea" "龙井"))))))
(func 记日志 (上下文 下一步) (set 请求数 (+ 请求数 1)) (let 号 请求数) (let 开始 (native time.ms)) (let 回复 (call 下一步 上下文)) (do (native log.error (rt join "#" 号 " 用了 " (- (native time.ms) 开始) " 毫秒"))) (do (rt log (rt join "#" 号 " " (. 上下文 方式) " " (. 上下文 路径) " → " (. 回复 状态码)))) (return (send 回复 加头 "X-Request-Id" 号)))
(class 预检 (implements 中间件) (method 处理 (上下文 下一步) (if (when (== (. 上下文 方式) "OPTIONS") (return (send (send 响应 空的) 加头 "Allow" "GET, POST, PUT, DELETE")))) (return (call 下一步 上下文))))
(class 鉴权 (implements 中间件) (private-field 钥匙们 (dict)) (ctor (钥匙们) (set (. (this) 钥匙们) 钥匙们)) (method 处理 (上下文 下一步) (let 头 (send 上下文 请求头 "Authorization")) (if (when (or (rt isNull 头) (not (rt startsWith 头 "Bearer "))) (throw (new 未授权)))) (let 用户 (rt dictGet (. (this) 钥匙们) (rt substring 头 7 (rt size 头)))) (if (when (rt isNull 用户) (throw (new 未授权 "钥匙不对")))) (do (send 上下文 放 "用户" 用户)) (return (call 下一步 上下文))))
(func 要管理员 (上下文) (if (when (!= (rt dictGet (send 上下文 取 "用户") "role") "admin") (throw (new 不许 "admin")))))
(func 书的校验 (新建) (let v (new 校验器)) (if (when 新建 (do (send (send v 必填 "title") 必填 "year")))) (do (send (send (send v 文字 "title" 1 40) 数字 "year" 1000 2100) 其中之一 "tag" (list "科幻" "文学" "未分类"))) (return v))
(func 找书 (上下文) (let 书 (send 书们 取 (call 要数字 (send 上下文 路径参数 "id") "id"))) (if (when (rt isNull 书) (throw (new 没有这个 "没有这本书")))) (return 书))
(main
  (do (send app 加 "GET" "/hello/:name" (fn (上下文) (return (send 响应 JSON 200 (dict ("hello" (send 上下文 路径参数 "name"))))))))
  (do (send app 用 记日志))
  (do (send app 用 (new 错误处理)))
  (do (send app 用 (new 预检)))
  (do (send app GET "/" (fn (上下文) (return "小书店"))))
  (do (send app GET "/health" (fn (上下文) (return (dict ("ok" true) ("books" (rt size (send 书们 全部))))))))
  (do (send app GET "/boom" (fn (上下文) (throw "炸了"))))
  (do (send app GET "/boom/teapot" (fn (上下文) (throw (new 茶壶)))))
  (do (send app GET "/boom/lib" (fn (上下文) (do (rt listSet (list) 5 1)) (return "不该到这里"))))
  (do (send app GET "/slow" (fn (上下文) (do (native time.sleep 30)) (return (dict ("slept" 30))))))
  (do (send app GET "/parallel" (fn (上下文) (let 甲 (spawn (do (native time.sleep 20)) (return 1))) (let 乙 (spawn (do (native time.sleep 10)) (return 2))) (return (dict ("sum" (+ (await 甲) (await 乙))))))))
  (let api (send app 分组 "/api"))
  (do (send api 用 (new 鉴权 (dict ("k-ming" (dict ("name" "小明") ("role" "admin"))) ("k-hong" (dict ("name" "小红") ("role" "reader")))))))
  (do (send api GET "/me" (fn (上下文) (return (send 上下文 取 "用户")))))
  (do (send api GET "/books" (fn (上下文) (let 标签 (send 上下文 网址参数 "tag")) (if (when (rt isNull 标签) (return (send 书们 全部)))) (return (rt listFilter (send 书们 全部) (-> (书) (== (rt dictGet 书 "tag") 标签)))))))
  (do (send api POST "/books" (fn (上下文) (let 数据 (send (call 书的校验 true) 检查 (send 上下文 内容))) (let 书 (send 书们 加 (dict ("title" (rt dictGet 数据 "title")) ("year" (rt dictGet 数据 "year")) ("tag" (rt orElse (rt dictGet 数据 "tag") "未分类")) ("by" (rt dictGet (send 上下文 取 "用户") "name"))))) (return (send (send 响应 JSON 201 书) 加头 "Location" (rt join "/api/books/" (rt dictGet 书 "id")))))))
  (do (send api GET "/books/:id" (fn (上下文) (return (call 找书 上下文)))))
  (do (send api PUT "/books/:id" (fn (上下文) (let 书 (call 找书 上下文)) (let 数据 (send (call 书的校验 false) 检查 (send 上下文 内容))) (let 改动 (dict)) (for-each 键 (list "title" "year" "tag") (if (when (rt dictHas 数据 键) (set (index 改动 键) (rt dictGet 数据 键))))) (return (send 书们 改 (rt dictGet 书 "id") 改动)))))
  (do (send api DELETE "/books/:id" (fn (上下文) (do (call 要管理员 上下文)) (let 书 (call 找书 上下文)) (do (send 书们 删 (rt dictGet 书 "id"))) (return null))))
  (let 作者组 (send api 分组 "/authors"))
  (do (send 作者组 用 (fn (上下文 下一步) (return (send (call 下一步 上下文) 加头 "X-Group" "authors")))))
  (do (send 作者组 GET "/" (fn (上下文) (return (send 作者们 全部)))))
  (do (send 作者组 POST "/" (fn (上下文) (let 数据 (send (send (send (new 校验器) 必填 "name") 文字 "name" 1 20) 检查 (send 上下文 内容))) (return (send 响应 JSON 201 (send 作者们 加 (dict ("name" (rt dictGet 数据 "name")))))))))
  (do (send app 开始服务 8200)))
