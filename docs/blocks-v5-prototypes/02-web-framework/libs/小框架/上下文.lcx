; 库“小框架”·上下文：一次请求从头到尾带着的东西。中间件可以往“数据”里放东西给后面的用（这就是“改请求”）。
(module 上下文
  (native url.decode (文字))

  (func 解析网址参数 (原文)
    (let 表 (dict))
    (for-each 段 (rt split 原文 "&")
      (if (when (== 段 "") (continue)))
      (let 等号 (rt indexOf 段 "="))
      (let 键 段)
      (let 值 "")
      (if (when (>= 等号 0)
            (set 键 (rt substring 段 0 等号))
            (set 值 (rt substring 段 (+ 等号 1) (rt size 段)))))
      (set 键 (native url.decode (rt replace 键 "+" " ")))
      (if (when (not (rt dictHas 表 键))
            (set (index 表 键) (native url.decode (rt replace 值 "+" " "))))))
    (return 表))

  (public (class 上下文
    (field 方式 "")
    (field 路径 "")
    (field 段们 (list))
    (field 路径参数们 (dict))
    (field 网址参数们 (dict))
    (field 数据 (dict))
    (private-field 请求 (dict))
    (private-field 内容读过了 false)
    (private-field 内容值 null)

    (ctor (请求)
      (set (. (this) 请求) 请求)
      (set (. (this) 方式) (rt dictGet 请求 "method"))
      (set (. (this) 路径) (rt dictGet 请求 "path"))
      (set (. (this) 段们) (list))
      (for-each 段 (rt split (rt dictGet 请求 "path") "/")
        (if (when (!= 段 "") (do (rt listPush (. (this) 段们) (native url.decode 段))))))
      (set (. (this) 路径参数们) (dict))
      (set (. (this) 网址参数们) (call 解析网址参数 (rt dictGet 请求 "query")))
      (set (. (this) 数据) (dict)))

    (method 路径参数 (名字)
      (return (rt dictGet (. (this) 路径参数们) 名字)))
    (method 网址参数 (名字)
      (return (rt dictGet (. (this) 网址参数们) 名字)))
    (method 请求头 (名字)
      (return (rt dictGet (rt dictGet (. (this) 请求) "headers") (rt lower 名字))))
    ; 请求内容按 JSON 解析（只解析一次）；没提交、不是合法 JSON → 空。
    (method 内容 ()
      (if (when (not (. (this) 内容读过了))
            (set (. (this) 内容值) (rt fromJson (rt dictGet (. (this) 请求) "body")))
            (set (. (this) 内容读过了) true)))
      (return (. (this) 内容值)))
    (method 放 (名字 值)
      (set (index (. (this) 数据) 名字) 值))
    (method 取 (名字)
      (return (rt dictGet (. (this) 数据) 名字))))))
